#!/usr/bin/env bash
# run_agy — the ONLY approved way to call the agy CLI for the Gemini seat.
#
# Usage:
#   run_agy "<prompt>"        # prompt as $1
#   run_agy < promptfile      # prompt on stdin (no args)
# Output: final assistant response on stdout. Nonzero exit = failed (caller
#         degrades, running with the remaining seats). agy's own stderr is forwarded.
#
# WHY this wrapper exists / the non-obvious agy contract:
#  - PROMPT VIA STDIN, NO `--print` FLAG. agy's `--print` is NOT a boolean — it
#    TAKES THE PROMPT AS ITS ARGUMENT (`--print "<prompt>"`; `--prompt` is an
#    alias). A bare `--print` with the prompt on stdin makes `--print` swallow the
#    NEXT token (`--model`) and desyncs the whole parse: --model AND --print-timeout
#    are silently dropped, so agy runs the ~/.gemini/.../settings.json default model
#    (Gemini 3.1 Pro) at the 5m DEFAULT print cap. Symptom seen in the field: every
#    attempt logged model="" and died at ~1497 polls (~5m), and the Pro->Flash
#    "fallback" was really two Pro runs. Fix: feed the prompt on stdin (a non-TTY
#    pipe that hits EOF) with NO `--print`; agy then reads stdin non-interactively
#    and the flags below actually bind. Confirmed in agy's own CLI logs: this form
#    logs the model label that was actually requested (`Propagating selected model
#    override to backend: label="…"`) and honors --print-timeout to the second.
#    agy 1.1.18 fixed the swallowing itself — a valueless `--print` and a stray trailing
#    argument are both hard errors now — but keep the stdin form: it is the one this
#    wrapper is verified against, and it works on every version tested, fix or no fix.
#  - --print-timeout=15m, =FORM. agy's default is 5m0s, which guillotines a heavy
#    review mid-investigation. 15m is enough for a thorough Flash/Pro pass; the
#    outer `timeout WALL_TIMEOUT` is the hard backstop if agy ever truly hangs.
#  - --dangerously-skip-permissions: REQUIRED so the seat can actually RUN its tools
#    non-interactively — tilth (native MCP), grep/read, and the scratch-script writes
#    the review prompt asks for. It auto-approves those tool calls; agy is already a
#    full agentic tool user, so this does not newly "unsandbox" it. Repo integrity is
#    enforced by scripts/repo_guard (snapshot + auto-revert), not by agy, on top of
#    the disposable-container trust model.
#  - PRIMARY Gemini 3.7 Flash (High), FALLBACK Gemini 3.1 Pro (High). 3.7 Flash is
#    the current best Gemini seat model; 3.1 Pro is the previous pin, kept as the
#    fallback so a primary failure still gets a full-quality second attempt from a
#    DIFFERENT model family (the two failure modes are unlikely to coincide). NOTE:
#    unlike the old Pro->Flash order, the fallback is NOT the faster model, so a
#    primary --print-timeout expiry costs a second full PRINT_TIMEOUT budget before
#    the seat is declared down; WALL_TIMEOUT bounds each attempt separately.
#  - PIN THE EXACT DISPLAY LABEL ("Gemini 3.7 Flash (High)"), NEVER the slug
#    ("gemini-3.7-flash-high"). The label form is the contract: it bound exactly on
#    every version tested (1.1.10 and 1.1.13). Slugs are not reliable across
#    versions — on 1.1.10 `gemini-3.1-pro-high` bound Gemini 3.6 Flash (High) and
#    `gemini-3.5-flash-low` bound Medium effort (they resolve correctly again on
#    1.1.13, so the misbind is a version-dependent regression, not a fixed rule).
#    How an UNRECOGNIZED value fails has itself changed between versions, so do not
#    rely on either behavior: 1.1.10 ran the user's ~/.gemini/antigravity-cli/
#    settings.json model silently (a bad pin downgraded the seat invisibly), while
#    1.1.13 hard-errors ("invalid model selection … is not recognized") and exits 1,
#    which attempt() reads as a failed attempt and answers with the other pin.
#    Effort is part of the label — do not add a separate --effort.
#    `agy models` lists what exists; copy its LABEL column (the second, tab-separated
#    field on 1.1.13 — on 1.1.10 piped output carried the slug column only, so on an
#    older agy read the listing on a TTY: `script -qc "agy models" /dev/null`).
#    `agy models --output-format json` does NOT exist in 1.1.13 despite the 1.1.12
#    changelog. When a new top model ships, update these lines and re-verify with
#    `tests/live/agy_model_binding.sh` — it proves through agy's own logs that the
#    pins bind (and `--model "<candidate>"` checks a label before you adopt it).
#    Never use agy's Claude/GPT-OSS entries: the Gemini seat must be a Gemini model.
#  - RECORD WHAT BOUND (optional; issue 63, the agy half of issue 47). With
#    AGY_SEAT_MODEL_FILE=/path set (await_seats sets /tmp/<ID>/agy-model.txt), each
#    attempt gets its own `--log-file` in agy-logs/ beside it (kept, see below), and
#    after a SUCCESSFUL attempt the labels agy logged as `Propagating selected model
#    override to backend: label="…"` are written there as `model=` next to
#    `requested=` (the pin that attempt asked for), so the verdict can say which Gemini
#    model reviewed the code. The file always describes the LAST successful pass: a
#    success with no recognized line removes an older record. Only a successful attempt is
#    read, on purpose: measured on agy 1.4.2, a REJECTED label still logs a propagation
#    line naming the settings.json default before the startup error, so a failed
#    attempt's log names a model that never ran. The log line is internal, not an
#    interface, so nothing depends on this record: an agy without `--log-file` (it is
#    probed in `agy --help`, which agy prints to stderr), or a log with no recognized
#    line, costs only the record, never the attempt.
#  - "Error: timed out waiting for response" IS --print-timeout firing. agy prints
#    that line and exits 0 (a clean exit, NOT a hang), leaving truncated output with
#    no findings block. attempt() therefore treats output that ENDS with that line
#    as a failure (see agy_ended_with_timeout) so the fallback model is tried; a real
#    review that merely QUOTES the phrase mid-content is unaffected (the match is
#    anchored to the final bytes). A genuine hang is caught by `timeout WALL_TIMEOUT`.

set -euo pipefail

# Exact agy display labels (see header: never slugs; an unrecognized value silently
# falls back to the user's settings.json default). Verified to bind by
# tests/live/agy_model_binding.sh on agy 1.1.13 (2026-08-15) and 1.1.18 (2026-08-22).
PRIMARY_MODEL="Gemini 3.1 Pro (High)"
FALLBACK_MODEL="Gemini 3.7 Flash (High)"
PRINT_TIMEOUT="15m"
WALL_TIMEOUT=1020   # seconds, hard outer bound per attempt (>= PRINT_TIMEOUT 15m + startup slack)
MODEL_FILE="${AGY_SEAT_MODEL_FILE:-}"

command -v agy >/dev/null 2>&1 || { echo "run_agy: agy CLI not found" >&2; exit 127; }

# True only when agy's output TERMINATES with its --print-timeout error line —
# "Error: " prefix required, anchored to the END of the output (tr drops newlines
# so the regex `$` matches the true end). agy writes this as the last thing when
# --print-timeout fires; a valid review that quotes the phrase has it mid-content,
# not as the final bytes.
agy_ended_with_timeout() {
  tail -c 160 "$1" 2>/dev/null | tr -d '\n' \
    | grep -qE 'Error: timed out waiting for response[[:space:]]*$'
}

promptfile="$(mktemp /tmp/agy_prompt.XXXXXX)"
outfile="$(mktemp /tmp/agy_out.XXXXXX)"
trap 'rm -f "$promptfile" "$outfile"' EXIT

# Only probe for --log-file when a record was asked for: an agy that predates the flag
# would hard-error on it, and passing it blindly would take the seat down to gain a
# record nothing depends on. Captured into a variable before matching, so an early
# grep exit cannot SIGPIPE agy under pipefail.
# The logs are KEPT, in agy-logs/ next to the record (/tmp/<ID>/agy-logs/ under the
# barrier): with --log-file agy writes nothing to its default log directory, so deleting
# them would lose the only diagnostics of a failed Gemini pass. They go with the run
# directory at cleanup, like the raw seat output.
log_dir=""
if [ -n "$MODEL_FILE" ]; then
  # Bounded: the probe sits outside both attempts' timeouts, so a hang here would
  # otherwise keep either model from ever being dispatched.
  agy_help="$(timeout 15 agy --help 2>&1 || true)"
  case "$agy_help" in
    *--log-file*)
      log_dir="$(dirname "$MODEL_FILE")/agy-logs"
      mkdir -p "$log_dir" 2>/dev/null || log_dir="" ;;
  esac
fi
logfile=""

if [ "$#" -ge 1 ]; then
  printf '%s' "$1" > "$promptfile"
else
  cat > "$promptfile"   # prompt on stdin; cat reaches EOF here
fi

# Run one model. agy's stdout -> $outfile (relayed verbatim by the caller on the
# chosen attempt); its stderr stays on our stderr (the caller captures it).
# Returns 0 on success, non-zero to trigger the fallback. Two failure paths: the
# attempt exits non-zero (agy error, or `timeout` killing a true hang), OR it exits
# 0 but its output ENDS with agy's --print-timeout error line (a fired print-timeout
# is a clean exit-0 with truncated, block-less output — see agy_ended_with_timeout).
attempt() {
  local model="$1" rc
  local log_args=()
  : > "$outfile"
  logfile=""
  if [ -n "$log_dir" ]; then
    logfile="$(mktemp "$log_dir/$(date -u +%Y%m%dT%H%M%SZ).XXXXXX" 2>/dev/null)" || logfile=""
    [ -n "$logfile" ] && log_args=(--log-file "$logfile")
  fi
  # NO bare `--print`: agy's --print TAKES THE PROMPT AS ITS ARGUMENT, so a bare
  # `--print` with the prompt on stdin swallows the following flag (--model) and
  # desyncs parsing — --model AND --print-timeout get dropped and agy silently
  # falls back to the ~/.gemini default model + the 5m default print cap. Feed the
  # prompt on stdin with NO --print (agy reads piped stdin non-interactively) so
  # the flags below actually bind. --print-timeout uses the =form for safety.
  if timeout "$WALL_TIMEOUT" agy \
       --print-timeout="$PRINT_TIMEOUT" \
       --model "$model" \
       --dangerously-skip-permissions \
       ${log_args[@]+"${log_args[@]}"} \
       < "$promptfile" > "$outfile"; then rc=0; else rc=$?; fi
  # A fired --print-timeout makes agy print its error line and exit 0 (a clean
  # exit, not a hang). Treat that truncated output as a failure so the fallback
  # model is tried — otherwise a timed-out attempt looks like success and the
  # caller relays output with no findings block.
  if agy_ended_with_timeout "$outfile"; then return 1; fi
  return "$rc"
}

# Write the labels agy logged as bound for the attempt that just SUCCEEDED (see the
# header: a failed attempt's log can name a model that never ran). Several distinct
# labels are recorded comma-joined rather than guessed between. When nothing is
# recognized, an older pass's record is removed rather than left to describe this one.
# Best effort only: never changes the seat's exit code.
record_bound_model() {
  local requested="$1" bound=""
  [ -n "$MODEL_FILE" ] || return 0
  if [ -n "$logfile" ]; then
    bound="$(grep -h 'Propagating selected model override to backend: label="' "$logfile" 2>/dev/null \
      | sed -n 's/.*label="\([^"]*\)".*/\1/p' | awk '!seen[$0]++' | paste -sd, - | sed 's/,/, /g')" || bound=""
  fi
  if [ -z "$bound" ]; then rm -f "$MODEL_FILE" 2>/dev/null || true; return 0; fi
  mkdir -p "$(dirname "$MODEL_FILE")" 2>/dev/null || return 0
  printf 'model=%s\nrequested=%s\n' "$bound" "$requested" > "$MODEL_FILE.tmp.$$" 2>/dev/null \
    && mv -f "$MODEL_FILE.tmp.$$" "$MODEL_FILE" 2>/dev/null || true
  return 0
}

if attempt "$PRIMARY_MODEL"; then
  record_bound_model "$PRIMARY_MODEL"
  cat "$outfile"
  exit 0
fi

echo "run_agy: primary model ('$PRIMARY_MODEL') failed (timeout/error); retrying with fallback ('$FALLBACK_MODEL')" >&2

if attempt "$FALLBACK_MODEL"; then
  record_bound_model "$FALLBACK_MODEL"
  cat "$outfile"
  exit 0
fi

# Both failed. Relay the last attempt's output (so the caller logs agy's own
# message) and exit non-zero so the referee degrades the Gemini seat.
cat "$outfile"
echo "run_agy: both primary ('$PRIMARY_MODEL') and fallback ('$FALLBACK_MODEL') models failed" >&2
exit 1
