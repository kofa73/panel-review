#!/usr/bin/env python3
"""CLI wrapper for the shared fenced-block scan in panel_common."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from panel_common import extract_fenced_block


def main():
    args = sys.argv[1:]
    present_only = bool(args and args[0] == "--present")
    if present_only:
        args = args[1:]
    if len(args) != 2:
        print("usage: extract_block [--present] <tag> <rawfile>", file=sys.stderr)
        return 2

    tag, path = args
    if not os.path.isfile(path):
        print(f"extract_block: no such file: {path}", file=sys.stderr)
        return 1

    try:
        with open(path, encoding="utf-8", errors="replace", newline="") as handle:
            present, content = extract_fenced_block(handle.read(), tag)
    except OSError as error:
        print(f"extract_block: cannot read {path}: {error}", file=sys.stderr)
        return 1

    if present_only:
        return 0 if present else 1
    sys.stdout.write(content)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
