#!/usr/bin/env bash
# init_run — start a fresh review run: mint an ID, create the canonical state
# dir, write the manifest, then create the workdir marker LAST (so a marker
# always implies valid /tmp state). Prints the minted <ID> on stdout.
#
# Usage:
#   init_run --workdir DIR --scope STR --diff-hash HEX
#           [--issue-rounds N] [--max-rounds N] [--seat-timeout N]
#           [--instructions STR] [--review-profile SELECTOR]
#
# --instructions is optional author guidance for the seats (free text, or the
# sentinel "auto" for referee-generated context). Stored verbatim in the manifest
# so it survives resume/continue; it is NOT part of the run's resume identity
# (resume_check never compares it).
# --review-profile selects a path, configured profile name, or builtin:generic.
# The user-config module resolves defaults and validates settings before this
# script creates run state. Exact profile bytes are snapshotted into the run.
#
# Creates:
#   /tmp/<ID>/manifest.json           (canonical; persistent volume)
#   /tmp/<ID>/{sweeps,raw,audit}/     (state subdirs)
#   /tmp/<ID>/index.json              (empty issue index)
#   <workdir>/.panel-review/<ID>/   (marker / per-worktree lock)
# and adds `.panel-review/` to <workdir>/.git/info/exclude.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"; . "$here/_panel_common.sh"

# Create all of this run's dirs private to the user. /tmp/<ID>/ holds the
# manifest (scope/instructions/diff_hash) and index; in a shared /tmp a default
# 0755 leaves them world-readable to other local accounts. umask here (not a
# post-hoc `mkdir -m 700` + chmod) makes every mkdir below land at 0700
# atomically, with no world-readable window. Files are unaffected — they go
# through panel_atomic_write's mktemp (already 0600).
umask 077

workdir="" scope="" iss="" mx="" timeout="" dh="" instr="" profile=""
iss_seen=false mx_seen=false timeout_seen=false profile_seen=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --workdir) [ "$#" -ge 2 ] || { echo "init_run: --workdir needs a value" >&2; exit 2; }; workdir="$2"; shift 2;;
    --scope) [ "$#" -ge 2 ] || { echo "init_run: --scope needs a value" >&2; exit 2; }; scope="$2"; shift 2;;
    --issue-rounds)
      [ "$iss_seen" = false ] || { echo "init_run: duplicate --issue-rounds" >&2; exit 2; }
      [ "$#" -ge 2 ] || { echo "init_run: --issue-rounds needs a value" >&2; exit 2; }
      iss="$2"; iss_seen=true; shift 2;;
    --max-rounds)
      [ "$mx_seen" = false ] || { echo "init_run: duplicate --max-rounds" >&2; exit 2; }
      [ "$#" -ge 2 ] || { echo "init_run: --max-rounds needs a value" >&2; exit 2; }
      mx="$2"; mx_seen=true; shift 2;;
    --seat-timeout)
      [ "$timeout_seen" = false ] || { echo "init_run: duplicate --seat-timeout" >&2; exit 2; }
      [ "$#" -ge 2 ] || { echo "init_run: --seat-timeout needs a value" >&2; exit 2; }
      timeout="$2"; timeout_seen=true; shift 2;;
    --diff-hash) [ "$#" -ge 2 ] || { echo "init_run: --diff-hash needs a value" >&2; exit 2; }; dh="$2"; shift 2;;
    --instructions) [ "$#" -ge 2 ] || { echo "init_run: --instructions needs a value" >&2; exit 2; }; instr="$2"; shift 2;;
    --review-profile)
      [ "$profile_seen" = false ] || { echo "init_run: duplicate --review-profile" >&2; exit 2; }
      [ "$#" -ge 2 ] || { echo "init_run: --review-profile needs a path" >&2; exit 2; }
      profile="$2"; profile_seen=true; shift 2;;
    *) echo "init_run: unknown arg: $1" >&2; exit 2;;
  esac
done
[ -n "$workdir" ] && [ -n "$scope" ] && [ -n "$dh" ] \
  || { echo "init_run: need --workdir --scope --diff-hash" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "init_run: jq not found" >&2; exit 127; }

# Resolve config and command-line precedence before claiming an ID. This keeps
# invalid settings, profile names, and config files from leaving partial state.
settings_args=()
[ "$iss_seen" = false ] || settings_args+=(--issue-rounds "$iss")
[ "$mx_seen" = false ] || settings_args+=(--max-rounds "$mx")
[ "$timeout_seen" = false ] || settings_args+=(--seat-timeout "$timeout")
[ "$profile_seen" = false ] || settings_args+=(--review-profile "$profile")
settings="$("$here/user_config.py" resolve-start "${settings_args[@]}")"
iss="$(jq -er '.limits.issue_rounds' <<<"$settings")"
mx="$(jq -er '.limits.max_rounds' <<<"$settings")"
timeout="$(jq -er '.limits.seat_timeout_seconds' <<<"$settings")"
profile="$(jq -er '.review_profile.source_path' <<<"$settings")"
profile_selector="$(jq -er '.review_profile.selector' <<<"$settings")"

# Once an ID has been claimed, any failure before marker publication removes its
# unpublished state. A caller must never find an orphan produced by bad profile input.
id=""; cleanup_new_run=true
cleanup_partial_run() {
  if [ "$cleanup_new_run" = true ] && [ -n "$id" ] && panel_valid_id "$id"; then
    rm -rf -- "/tmp/$id"
  fi
}
trap cleanup_partial_run EXIT

# Mint an ID and claim ONLY /tmp/<ID> with exclusive mkdir; retry on rare clash.
# The workdir marker is published LAST (after canonical state exists), so a
# marker on disk always implies a valid /tmp state behind it.
for _try in 1 2 3 4 5; do
  id="panel-$(date +%Y%m%d-%H%M%S)-$(openssl rand -hex 4 2>/dev/null || printf '%04x%04x' "$RANDOM" "$RANDOM")"
  panel_valid_id "$id" || { id=""; continue; }
  if mkdir "/tmp/$id" 2>/dev/null; then break; fi
  id=""
done
[ -n "${id:-}" ] || { echo "init_run: could not allocate a run id" >&2; exit 1; }

mkdir -p "/tmp/$id/sweeps" "/tmp/$id/raw" "/tmp/$id/audit"
profile_meta="$("$here/stage_review_profile" --source "$profile" --destination "/tmp/$id/review-profile.md")"
profile_meta="$(jq --arg selector "$profile_selector" '. + {selector:$selector}' <<<"$profile_meta")"
divergence_snapshot_file="/tmp/$id/divergence_snapshot.json"
"$here/scope_diagnostics" snapshot --workdir "$workdir" --scope "$scope" > "$divergence_snapshot_file"

jq -n --slurpfile divergence_snapshot "$divergence_snapshot_file" \
      --arg id "$id" --arg wd "$workdir" --arg scope "$scope" \
      --argjson iss "$iss" --argjson mx "$mx" --argjson timeout "$timeout" --arg dh "$dh" \
      --arg instr "$instr" --argjson profile "$profile_meta" \
      --arg created "$(date '+%Y-%m-%d %H:%M:%S')" '{
  id:$id, workdir:$wd, scope:$scope,
  limits:{issue_rounds:$iss, max_rounds:$mx, seat_timeout_seconds:$timeout},
  diff_hash:$dh, instructions:$instr, review_profile:$profile,
  divergence_snapshot:$divergence_snapshot[0],
  created:$created
}' | panel_atomic_write "/tmp/$id/manifest.json"
rm -f -- "$divergence_snapshot_file"

printf '{"issues":[],"round":0,"phase":"round0","committed_rounds":[],"evaluated_by":{}}\n' | panel_atomic_write "/tmp/$id/index.json"

# Marker LAST: canonical /tmp state is now durably in place. Serialize marker
# publication per worktree so concurrent fresh starts converge on one run.
base="$workdir/.panel-review"
mkdir -p "$base"
exec 9>"$base/.init.lock"
flock -x 9
for d in "$base"/*/; do
  [ -f "$d/.panel-run" ] || continue
  winner="$(basename "$d")"
  if panel_valid_id "$winner"; then
    rm -rf -- "/tmp/$id"
    printf '%s\n' "$winner"
    exit 0
  fi
done
marker="$base/$id"
mkdir "$marker" 2>/dev/null || { echo "init_run: marker already exists: $marker" >&2; exit 1; }
printf '%s\n' "$id" | panel_atomic_write "$marker/.panel-run"

cleanup_new_run=false
panel_git_exclude_add "$workdir" ".panel-review/"

printf '%s\n' "$id"
