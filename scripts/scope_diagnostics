#!/usr/bin/env python3
"""Capture and compare the uncommitted paths that define a run's scope."""

import argparse
import base64
import hashlib
import json
from pathlib import Path
import subprocess
import sys


PATHSPEC = [".", ":(exclude).panel-review/**"]


class DiagnosticError(Exception):
    pass


def git(workdir, *args, input_data=None):
    result = subprocess.run(
        ["git", "-C", str(workdir), *args],
        input=input_data,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").strip()
        raise DiagnosticError(detail or f"git {args[0]} failed")
    return result.stdout


def tracked_diff(workdir):
    has_head = subprocess.run(
        ["git", "-C", str(workdir), "rev-parse", "--verify", "-q", "HEAD"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0
    command = ["diff", "HEAD"] if has_head else ["diff", "--cached"]
    return git(workdir, *command, "--", *PATHSPEC)


def untracked_paths(workdir):
    raw = git(
        workdir,
        "ls-files",
        "-z",
        "--others",
        "--exclude-standard",
        "--",
        *PATHSPEC,
    )
    return sorted(path for path in raw.split(b"\0") if path)


def display_path(path):
    decoded = path.decode("utf-8", "backslashreplace")
    return "".join(
        f"\\x{ord(char):02x}" if ord(char) < 32 or ord(char) == 127 else char
        for char in decoded
    )


def collect_snapshot(workdir):
    paths = untracked_paths(workdir)
    return {
        "tracked_diff_hash": hashlib.sha256(tracked_diff(workdir)).hexdigest(),
        "untracked_paths_b64": [base64.b64encode(path).decode("ascii") for path in paths],
    }


def manifest_snapshot(manifest):
    value = manifest.get("divergence_snapshot")
    if not isinstance(value, dict):
        return None
    tracked_hash = value.get("tracked_diff_hash")
    paths = value.get("untracked_paths_b64")
    if (
        not isinstance(tracked_hash, str)
        or len(tracked_hash) != 64
        or not isinstance(paths, list)
        or any(not isinstance(path, str) for path in paths)
    ):
        return None
    try:
        decoded = {base64.b64decode(path, validate=True) for path in paths}
    except (ValueError, base64.binascii.Error):
        return None
    return tracked_hash, decoded


def saved_diff_paths(path):
    try:
        patch = Path(path).read_bytes()
    except OSError:
        return None
    if not patch:
        return set()
    result = subprocess.run(
        ["git", "apply", "--numstat", "-z"],
        input=patch,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        return None
    paths = set()
    for record in result.stdout.split(b"\0"):
        fields = record.split(b"\t", 2)
        if len(fields) == 3 and fields[2]:
            paths.add(fields[2])
    return paths


def compare(workdir, manifest, baseline_diff):
    if manifest.get("scope") != "uncommitted":
        return {
            "available": False,
            "reason": "path diagnostics are available only for uncommitted scope",
        }
    try:
        current_paths = set(untracked_paths(workdir))
    except DiagnosticError as error:
        return {"available": False, "reason": str(error)}

    snapshot = manifest_snapshot(manifest)
    if snapshot is not None:
        tracked_hash, old_paths = snapshot
        try:
            current_tracked_hash = hashlib.sha256(tracked_diff(workdir)).hexdigest()
        except DiagnosticError as error:
            return {"available": False, "reason": str(error)}
        return {
            "available": True,
            "source": "manifest",
            "tracked_content_changed": current_tracked_hash != tracked_hash,
            "new_untracked_paths": [display_path(path) for path in sorted(current_paths - old_paths)],
            "removed_untracked_paths": [display_path(path) for path in sorted(old_paths - current_paths)],
        }

    old_paths = saved_diff_paths(baseline_diff)
    if old_paths is None:
        return {
            "available": False,
            "reason": "this run has no saved uncommitted path snapshot",
        }
    return {
        "available": True,
        "source": "saved-diff-paths",
        "tracked_content_changed": None,
        "new_untracked_paths": [display_path(path) for path in sorted(current_paths - old_paths)],
        "removed_untracked_paths": None,
    }


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)

    snapshot_parser = commands.add_parser("snapshot")
    snapshot_parser.add_argument("--workdir", required=True)
    snapshot_parser.add_argument("--scope", required=True)

    compare_parser = commands.add_parser("compare")
    compare_parser.add_argument("--workdir", required=True)
    compare_parser.add_argument("--manifest", required=True)
    compare_parser.add_argument("--baseline-diff", required=True)

    args = parser.parse_args(argv)
    try:
        if args.command == "snapshot":
            result = collect_snapshot(args.workdir) if args.scope == "uncommitted" else None
        else:
            manifest = json.loads(Path(args.manifest).read_text(encoding="utf-8"))
            if not isinstance(manifest, dict):
                raise DiagnosticError("manifest is not a JSON object")
            result = compare(args.workdir, manifest, args.baseline_diff)
    except (DiagnosticError, OSError, json.JSONDecodeError) as error:
        print(f"scope_diagnostics: {error}", file=sys.stderr)
        return 1
    print(json.dumps(result, ensure_ascii=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
