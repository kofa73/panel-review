#!/usr/bin/env python3
"""Build the Round-0 index mechanically from the referee's clustered issue map.

Usage: birth_index --available "<seats>" --configured "<seats>" < issues.json

Input is a JSON array or an object with an ``issues`` array. Each issue has a safe ``id``,
``claim``, ``location``, ``category``, ``severity``, non-empty ``evidence_pro`` points, and distinct
``raised_by`` seats. ``evidence_contra`` and ``detail_divergence`` are optional. Birth unanimity
requires at least two available seats and every available seat among the raisers; only then is the
issue accepted and peer reviewed. Full-panel coverage controls ``fully_vetted``.

Exit 0 means a complete index was written; 1 means invalid input; 2 means invalid arguments; 3 means
an issue or panel validation failed.
"""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from panel_common import CATEGORIES, SEVERITIES, panel_valid_id, valid_location, valid_point


def display(value):
    if isinstance(value, str):
        return value
    return json.dumps(value, separators=(",", ":"), ensure_ascii=False)


def validation_errors(specs, available, configured):
    errors = [
        f"available seat not in configured panel: {seat}"
        for seat in available
        if seat not in configured
    ]

    ids = [spec.get("id") for spec in specs if type(spec) is dict and spec.get("id") is not None]
    seen_ids = []
    duplicate_ids = []
    for issue_id in ids:
        if issue_id in seen_ids and issue_id not in duplicate_ids:
            duplicate_ids.append(issue_id)
        elif issue_id not in seen_ids:
            seen_ids.append(issue_id)
    errors.extend(f"duplicate issue id: {display(issue_id)}" for issue_id in duplicate_ids)

    for number, spec in enumerate(specs):
        if type(spec) is not dict:
            errors.append(f"item {number}: not a JSON object")
            continue

        issue_id = spec.get("id")
        if not panel_valid_id(issue_id):
            errors.append(f"item {number}: missing/invalid `id` (safe token)")
            continue

        checks = (
            (type(spec.get("claim")) is str, "missing/non-string `claim`"),
            ("location" in spec and valid_location(spec["location"]), "missing/invalid `location`"),
            (type(spec.get("category")) is str and spec["category"] in CATEGORIES, "missing/invalid `category`"),
            (type(spec.get("severity")) is str and spec["severity"] in SEVERITIES, "missing/invalid `severity`"),
            (
                type(spec.get("evidence_pro")) is list
                and bool(spec["evidence_pro"])
                and all(valid_point(point) for point in spec["evidence_pro"]),
                "`evidence_pro` must be a non-empty array of valid points",
            ),
            (
                "evidence_contra" not in spec
                or (
                    type(spec["evidence_contra"]) is list
                    and all(valid_point(point) for point in spec["evidence_contra"])
                ),
                "`evidence_contra` must be an array of valid points",
            ),
            (
                type(spec.get("raised_by")) is list
                and bool(spec["raised_by"])
                and all(type(seat) is str for seat in spec["raised_by"])
                and len(set(spec["raised_by"])) == len(spec["raised_by"]),
                "`raised_by` must be a non-empty array of distinct seat names",
            ),
            (
                "detail_divergence" not in spec or type(spec["detail_divergence"]) is bool,
                "`detail_divergence` must be boolean",
            ),
        )
        errors.extend(f"issue {issue_id}: {message}" for valid, message in checks if not valid)
        if spec.get("severity") == "style":
            errors.append(f"issue {issue_id}: severity:style is not a debate issue — keep it aside for the Style section")
        raw_raisers = spec.get("raised_by")
        if raw_raisers is None or raw_raisers is False:
            raw_raisers = []
        raisers = raw_raisers if type(raw_raisers) in (list, str) else []
        errors.extend(
            f"issue {issue_id}: raiser is not an available seat: {seat}"
            for seat in raisers
            if seat not in available
        )

    return errors


def build_index(specs, available, configured):
    issues = []
    evaluated_by = {}
    for spec in specs:
        raisers = sorted(set(spec["raised_by"]))
        unanimous = len(available) >= 2 and all(seat in raisers for seat in available)
        fully_vetted = unanimous and all(seat in raisers for seat in configured)
        issues.append(
            {
                "id": spec["id"],
                "claim": spec["claim"],
                "location": spec["location"],
                "category": spec["category"],
                "severity": spec["severity"],
                "evidence_pro": spec["evidence_pro"],
                "evidence_contra": spec.get("evidence_contra", []),
                "peer_reviewed": unanimous,
                "fully_vetted": fully_vetted,
                "detail_contested": unanimous and spec.get("detail_divergence", False),
                "state": "accepted" if unanimous else "open",
                "rounds_debated": 0,
            }
        )
        evaluated_by[spec["id"]] = raisers

    return {
        "issues": issues,
        "round": 0,
        "phase": "debate",
        "committed_rounds": [],
        "run_epoch": 0,
        "evaluated_by": evaluated_by,
    }


def main():
    available = []
    configured = []
    configured_value = None
    args = sys.argv[1:]
    while args:
        option = args.pop(0)
        if option not in ("--available", "--configured") or not args:
            print(f"birth_index: unknown arg: {option}", file=sys.stderr)
            return 2
        raw_value = args.pop(0)
        value = raw_value.split()
        if option == "--available":
            available = value
        else:
            configured_value = raw_value
            configured = value

    if configured_value is None or not configured_value:
        print("birth_index: --configured required", file=sys.stderr)
        return 2

    raw = sys.stdin.read()
    if not raw.strip():
        raw = "[]"
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        print('birth_index: stdin must be a JSON array or {"issues":[...]}', file=sys.stderr)
        return 1

    if type(data) is dict and "issues" in data:
        specs = data["issues"]
    elif type(data) is list:
        specs = data
    else:
        print('birth_index: stdin must be a JSON array or {"issues":[...]}', file=sys.stderr)
        return 1
    if type(specs) is not list:
        print("birth_index: validation error: issues must be an array", file=sys.stderr)
        return 3

    errors = validation_errors(specs, available, configured)
    if errors:
        print("birth_index: validation violation(s):", file=sys.stderr)
        for error in errors:
            print(f"  - {error}", file=sys.stderr)
        return 3

    print(json.dumps(build_index(specs, available, configured), ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
