#!/usr/bin/env bash
# preflight — verify the panel-review environment.
#
# Hard requirements: jq, git, a git work tree, a writable cwd, access to /tmp,
# and at least one PEER seat — the codex CLI or agy (Gemini). The Claude seat is
# the host and is always present; Codex and Gemini are interchangeable optional
# peers, so the review only needs Claude + one of them.
#
# Exit 1 if the core is unusable; exit 0 otherwise. Prints human-readable
# status. The final three lines are "CODEX_MODEL_LAYER: yes|no", "CODEX: yes|no"
# and "GEMINI: yes|no" for scripted detection. CODEX_MODEL_LAYER reports a Codex
# config layer above the panel-review profile that sets the seat's model — a
# warning the caller must surface, never a hard failure.
#
# Single source of truth for both the skill and /panel-review's prereq report —
# keep the checks here so the two can't drift. Writes no files (read-only):
# run_codex owns Codex-profile creation.
set -uo pipefail   # not -e: accumulate all failures before reporting

hard_fail=0

command -v jq    >/dev/null 2>&1 || { echo "ERROR: install jq"; hard_fail=1; }
command -v git   >/dev/null 2>&1 || { echo "ERROR: install git"; hard_fail=1; }

# Fork mode must be OFF. It removes the Agent tool's run_in_background parameter and
# schedules EVERY subagent in the background, so the referee's two seat-dispatch Agent
# calls stop blocking: the referee is woken once PER SEAT and must decide, by
# instruction-following alone, not to collect on a partial wake. Measured on 2.1.233
# (4 trials, issues/25-fork-mode-backgrounds-seat-agents.md): none collected early, but
# 1 of 4 abandoned yielding and improvised a polling wait — the ~130-turn blow-up
# issue 15 removed. Blocking dispatch has no such variance, which is why this is a hard
# failure rather than a warning.
#
# Only the literal "0" is detectable as off: UNSET means "harness default", which is ON
# in interactive sessions from Claude Code 2.1.232. So require the explicit value and
# refuse everything else, including unset. This also refuses a `claude -p` session, where
# the default is already off — accepted, because the variable is harmless to set there and
# an undocumented entrypoint sniff would be a worse dependency.
if [ "${CLAUDE_CODE_FORK_SUBAGENT:-}" != "0" ]; then
  echo "ERROR: fork mode may be on — seat dispatch would not block, so the referee could"
  echo "       read seat output before the seats have written it. Start a NEW session with:"
  echo "           CLAUDE_CODE_FORK_SUBAGENT=0 claude"
  echo "       Do not export it globally (it disables forks for all your work); see README"
  echo "       \"Requirements\" for the recommended alias/wrapper."
  hard_fail=1
fi

# Panel state and the canonical seat inputs live under /tmp, outside the repository.
# Claude Code 2.1.257+ can block the native file tools and recognized shell reads
# there even in bypassPermissions mode. An opaque script cannot query Claude Code's
# effective working-directory list, so a --add-dir launch carries an explicit marker;
# persistent additionalDirectories entries can be verified directly below.
if command -v jq >/dev/null 2>&1; then
  config_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
  # The two project-scoped files have DIFFERENT bases on purpose — this is not a typo.
  # Claude Code reads the shared .claude/settings.json from the session's primary working
  # directory, but .claude/settings.local.json from the git repository root (since 2.1.211;
  # in a worktree, the main checkout's root). So "$project_root/.claude/settings.json" is
  # deliberately absent: Claude Code never reads it, and a /tmp grant placed there would not
  # take effect. Documented under "Where Claude Code keeps the local file in a git
  # repository" in the settings reference.
  #
  # Known gap: in the documented cases where the local file stays beside settings.json
  # instead (outside a repository, repo root == $HOME, Windows, root not owned by the user),
  # and for a pre-2.1.211 leftover in the starting directory, "$PWD/.claude/settings.local.json"
  # is not inspected. That can miss either an enabling `true` or a /tmp grant.
  settings_files=(
    "$config_home/settings.json"
    "$PWD/.claude/settings.json"
    "$project_root/.claude/settings.local.json"
    "/etc/claude-code/managed-settings.json"
    "/Library/Application Support/ClaudeCode/managed-settings.json"
  )
  for file in /etc/claude-code/managed-settings.d/*.json \
              "/Library/Application Support/ClaudeCode/managed-settings.d/"*.json; do
    [ -f "$file" ] && settings_files+=("$file")
  done

  blocking_files=()
  tmp_configured=0
  for file in "${settings_files[@]}"; do
    [ -f "$file" ] || continue
    jq -e '.permissions.blockReadsOutsideWorkingDirectories == true' "$file" >/dev/null 2>&1 \
      && blocking_files+=("$file")
    jq -e '(.permissions.additionalDirectories // []) | any(. == "/tmp" or . == "/tmp/")' \
      "$file" >/dev/null 2>&1 && tmp_configured=1
  done

  if [ "${#blocking_files[@]}" -gt 0 ] \
     && [ "$tmp_configured" -ne 1 ] \
     && [ "${PANEL_REVIEW_TMP_ADDED:-}" != "1" ]; then
    echo "ERROR: permissions.blockReadsOutsideWorkingDirectories blocks panel-review's /tmp state."
    echo "       Enabled by:"
    for file in "${blocking_files[@]}"; do echo "           $file"; done
    echo "       Add this object (merge it with existing permissions) to either:"
    echo "           repository: $PWD/.claude/settings.json"
    echo "           user:       $config_home/settings.json"
    echo '       {'
    echo '         "permissions": {'
    echo '           "additionalDirectories": ["/tmp"]'
    echo '         }'
    echo '       }'
    echo "       Then start a new session. Alternatively, launch it with:"
    echo "           PANEL_REVIEW_TMP_ADDED=1 CLAUDE_CODE_FORK_SUBAGENT=0 claude --add-dir /tmp"
    hard_fail=1
  fi
fi

# At least one peer seat must be present.
have_codex=no;  command -v codex >/dev/null 2>&1 && have_codex=yes
have_gemini=no; command -v agy   >/dev/null 2>&1 && have_gemini=yes

# The Codex seat's model pin is NOT authoritative on its own. Codex composes its
# configuration from layers, and three of them sit ABOVE the `--profile panel-review`
# layer that carries our pin (codex-rs/config/src/loader/mod.rs:105-121, checkout
# ddf04ad267): cwd `$PWD/config.toml`, tree `.codex/config.toml` in $PWD and its
# ancestors, and repo `$(git rev-parse --show-toplevel)/.codex/config.toml`. `codex exec`
# runs with cwd = the repository under review, so a reviewed repository that ships its own
# Codex config silently decides which model reviews it. Measured on codex-cli 0.153.4:
# in a repository whose `.codex/config.toml` set `gpt-5.6-luna`/`max`, the seat bound
# exactly that, while the profile's `gpt-5.6-sol`/`high` bound in a repository without one.
#
# This is a REPORT, not an override. Reviewing a repository under its own configured
# model is a legitimate choice — the user wrote that file. What must not happen is that
# the choice is invisible, because the pin is what makes two runs comparable. `start`
# asks; `run_codex` records what actually bound (see `/tmp/<ID>/codex-model.txt`).
codex_model_layer=no
if [ "$have_codex" = yes ]; then
  # Read a bare top-level `key = value` from a TOML file. Everything from the first table
  # header on belongs to some `[table]`, where `model` is a different key entirely, so stop
  # there. Comment stripping is naive (a `#` inside a quoted value would be cut); model
  # names and effort levels contain none.
  toml_root_value() {
    sed -e 's/#.*//' "$1" 2>/dev/null \
      | sed -n '/^[[:space:]]*\[/q;p' \
      | sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*[\"']\{0,1\}\([^\"']*\)[\"']\{0,1\}[[:space:]]*\$/\1/p" \
      | head -n1
  }

  # $HOME/.codex, not $CODEX_HOME, on purpose: this must name the same file run_codex
  # creates and pins from, and run_codex uses $HOME. Before the first run that file does
  # not exist yet, so fall back to the shipped asset run_codex will copy into place.
  codex_home="$HOME/.codex"
  codex_profile="${CODEX_PROFILE:-panel-review}"
  profile_file="$codex_home/$codex_profile.config.toml"
  [ -f "$profile_file" ] \
    || profile_file="$(cd "$(dirname "$0")" && pwd)/../assets/default-$codex_profile.config.toml"

  # Candidates: the cwd layer, then the tree layer walked to the filesystem root. The repo
  # layer's `$(git rev-parse --show-toplevel)/.codex/config.toml` is always one of the tree
  # candidates, since the toplevel is $PWD or an ancestor of it. Codex skips a `.codex` that
  # IS its own home (that file is the lower-precedence user layer), so skip it here too.
  candidates=("$(pwd -P)/config.toml")
  dir="$(pwd -P)"
  while :; do
    if [ "$dir/.codex" != "$codex_home" ] && ! [ "$dir/.codex" -ef "$codex_home" ] 2>/dev/null; then
      candidates+=("$dir/.codex/config.toml")
    fi
    [ "$dir" = "/" ] && break
    dir="$(dirname "$dir")"
  done

  overriding=()
  for file in "${candidates[@]}"; do
    [ -f "$file" ] || continue
    layer_model="$(toml_root_value "$file" model)"
    layer_effort="$(toml_root_value "$file" model_reasoning_effort)"
    [ -n "$layer_model" ] || [ -n "$layer_effort" ] || continue
    overriding+=("$file|${layer_model:-<unset>}|${layer_effort:-<unset>}")
  done

  if [ "${#overriding[@]}" -gt 0 ]; then
    codex_model_layer=yes
    pin_model="$(toml_root_value "$profile_file" model)"
    pin_effort="$(toml_root_value "$profile_file" model_reasoning_effort)"
    echo "WARNING: a Codex config layer above the panel-review profile sets the seat's model."
    echo "         Codex resolves cwd/tree/repo config ABOVE '--profile $codex_profile', so these win:"
    for entry in "${overriding[@]}"; do
      echo "             ${entry%%|*}"
      rest="${entry#*|}"
      echo "                 model = ${rest%%|*}   model_reasoning_effort = ${rest#*|}"
    done
    echo "         panel-review pins model = ${pin_model:-<unset>}   model_reasoning_effort = ${pin_effort:-<unset>}"
    echo "         from $profile_file"
    echo "         Codex disables these layers for an untrusted directory, so this may not apply —"
    echo "         it is reported, not predicted. Reviewing under the repository's own model is a"
    echo "         legitimate choice; it just must not be invisible, because the pin is what makes"
    echo "         two runs comparable. Move or edit the file to review under the pin instead."
  fi
fi
if [ "$have_codex" = no ] && [ "$have_gemini" = no ]; then
  echo "ERROR: no peer seat available — install the codex CLI (npm i -g @openai/codex) or agy (Gemini)."
  hard_fail=1
fi

# Runtime needs a git work tree (diff resolution, .git/info/exclude) and a
# writable cwd (cards live in .panel-review/ under the repo root).
if command -v git >/dev/null 2>&1; then
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "ERROR: run from inside a git work tree"; hard_fail=1; }
fi
[ -w "." ] || { echo "ERROR: working directory is not writable (cards need .panel-review/ here)"; hard_fail=1; }

# Soft checks
if [ "$have_codex" = yes ]; then
  # `codex login status` prints "Logged in ..." when authed; key the warning off
  # that (the old `codex login --check` is not a valid subcommand, so it always
  # failed and the warning fired on every run even when Codex was usable). NOTE:
  # codex writes that line to STDERR, so merge 2>&1 before grep — discarding stderr
  # would reintroduce the always-warns bug.
  codex login status 2>&1 | grep -qi "logged in" || echo "WARNING: run 'codex login'"
else
  echo "NOTE: codex CLI not found — Codex seat unavailable (running without it)."
fi
if [ "$have_gemini" = no ]; then
  echo "NOTE: agy CLI not found — Gemini seat unavailable (running without it)."
fi

echo "CODEX_MODEL_LAYER: $codex_model_layer"
echo "CODEX: $have_codex"
echo "GEMINI: $have_gemini"

exit "$hard_fail"
