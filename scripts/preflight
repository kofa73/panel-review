#!/usr/bin/env bash
# preflight — verify the panel-review environment.
#
# Hard requirements: jq, git, a git work tree, a writable cwd, and at least one
# PEER seat — the codex CLI or agy (Gemini). The Claude seat is the host and is
# always present; Codex and Gemini are interchangeable optional peers, so the
# review only needs Claude + one of them.
#
# Exit 1 if the core is unusable; exit 0 otherwise. Prints human-readable
# status. The final two lines are "CODEX: yes|no" and "GEMINI: yes|no" for
# scripted seat detection.
#
# Single source of truth for both the skill and /panel-review's prereq report —
# keep the checks here so the two can't drift. Writes no files (read-only):
# run_codex owns Codex-profile creation.
set -uo pipefail   # not -e: accumulate all failures before reporting

hard_fail=0

command -v jq    >/dev/null 2>&1 || { echo "ERROR: install jq"; hard_fail=1; }
command -v git   >/dev/null 2>&1 || { echo "ERROR: install git"; hard_fail=1; }

# Fork mode must be OFF. It removes the Agent tool's run_in_background parameter and
# schedules EVERY subagent in the background, so the referee's two seat-dispatch Agent
# calls stop blocking: the referee is woken once PER SEAT and must decide, by
# instruction-following alone, not to collect on a partial wake. Measured on 2.1.233
# (4 trials, issues/25-fork-mode-backgrounds-seat-agents.md): none collected early, but
# 1 of 4 abandoned yielding and improvised a polling wait — the ~130-turn blow-up
# issue 15 removed. Blocking dispatch has no such variance, which is why this is a hard
# failure rather than a warning.
#
# Only the literal "0" is detectable as off: UNSET means "harness default", which is ON
# in interactive sessions from Claude Code 2.1.232. So require the explicit value and
# refuse everything else, including unset. This also refuses a `claude -p` session, where
# the default is already off — accepted, because the variable is harmless to set there and
# an undocumented entrypoint sniff would be a worse dependency.
if [ "${CLAUDE_CODE_FORK_SUBAGENT:-}" != "0" ]; then
  echo "ERROR: fork mode may be on — seat dispatch would not block, so the referee could"
  echo "       read seat output before the seats have written it. Start a NEW session with:"
  echo "           CLAUDE_CODE_FORK_SUBAGENT=0 claude"
  echo "       Do not export it globally (it disables forks for all your work); see README"
  echo "       \"Requirements\" for the recommended alias/wrapper."
  hard_fail=1
fi

# At least one peer seat must be present.
have_codex=no;  command -v codex >/dev/null 2>&1 && have_codex=yes
have_gemini=no; command -v agy   >/dev/null 2>&1 && have_gemini=yes
if [ "$have_codex" = no ] && [ "$have_gemini" = no ]; then
  echo "ERROR: no peer seat available — install the codex CLI (npm i -g @openai/codex) or agy (Gemini)."
  hard_fail=1
fi

# Runtime needs a git work tree (diff resolution, .git/info/exclude) and a
# writable cwd (cards live in .panel-review/ under the repo root).
if command -v git >/dev/null 2>&1; then
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "ERROR: run from inside a git work tree"; hard_fail=1; }
fi
[ -w "." ] || { echo "ERROR: working directory is not writable (cards need .panel-review/ here)"; hard_fail=1; }

# Soft checks
if [ "$have_codex" = yes ]; then
  # `codex login status` prints "Logged in ..." when authed; key the warning off
  # that (the old `codex login --check` is not a valid subcommand, so it always
  # failed and the warning fired on every run even when Codex was usable). NOTE:
  # codex writes that line to STDERR, so merge 2>&1 before grep — discarding stderr
  # would reintroduce the always-warns bug.
  codex login status 2>&1 | grep -qi "logged in" || echo "WARNING: run 'codex login'"
else
  echo "NOTE: codex CLI not found — Codex seat unavailable (running without it)."
fi
if [ "$have_gemini" = no ]; then
  echo "NOTE: agy CLI not found — Gemini seat unavailable (running without it)."
fi

echo "CODEX: $have_codex"
echo "GEMINI: $have_gemini"

exit "$hard_fail"
