#!/usr/bin/env python3
"""Check executable-instruction ownership and rendered seat contracts."""

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile

from seat_contract import PHASES, get_rules, render_contract, response_problem


def normalized(text):
    return re.sub(r"\s+", " ", text).strip()


def fail(errors, invariant, location, detail):
    errors.append(f"{invariant}: {location}: {detail}")


def read(root, relative):
    path = root / relative
    try:
        return path.read_text(encoding="utf-8")
    except OSError as error:
        raise RuntimeError(f"cannot read {relative}: {error}") from error


def read_protocol_phase(root, phase):
    reader = root / "scripts" / "read_protocol_phase"
    try:
        result = subprocess.run(
            [str(reader), phase],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as error:
        raise RuntimeError(f"cannot render protocol phase {phase}: {error}") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"cannot render protocol phase {phase}: {detail}")
    return result.stdout


def check_merge_payload_contract(errors, root):
    """Probe the addendum boundary so misspellings and consumed-field shapes fail closed."""
    script = root / "scripts" / "merge_payload"
    if not script.is_file():
        fail(errors, "merge-payload-validation", "scripts/merge_payload", "script is missing")
        return

    probes = [
        ({}, {"add_issue": []}, 'addendum has unknown key "add_issue"'),
        ({}, {"add_evidence": {}}, "addendum .add_evidence is not a list"),
        ({}, {"add_issues": "oops"}, "addendum .add_issues is not a list"),
        ({}, {"evaluated_by": "x"}, "addendum .evaluated_by is not an object"),
        ({"evaluated_by": "x"}, {}, "base .evaluated_by is not an object"),
    ]
    for key, expected in (
        ("add_evidence", "is not a list"),
        ("add_issues", "is not a list"),
        ("evaluated_by", "is not an object"),
    ):
        for invalid_value in (None, False):
            detail = f".{key} {expected}"
            probes.append(({}, {key: invalid_value}, f"addendum {detail}"))
            probes.append(({key: invalid_value}, {}, f"base {detail}"))
    with tempfile.TemporaryDirectory(prefix="panel-contract-merge-") as directory:
        base_path = Path(directory) / "base.json"
        for base, addendum, expected in probes:
            base_path.write_text(json.dumps(base), encoding="utf-8")
            try:
                result = subprocess.run(
                    [sys.executable, str(script), str(base_path)],
                    input=json.dumps(addendum),
                    capture_output=True,
                    text=True,
                    check=False,
                )
            except OSError as error:
                fail(errors, "merge-payload-validation", "scripts/merge_payload", str(error))
                return
            if result.returncode != 2 or expected not in result.stderr or "Traceback" in result.stderr:
                fail(
                    errors,
                    "merge-payload-validation",
                    "scripts/merge_payload",
                    f"expected exit 2 with `{expected}` and no traceback; got exit {result.returncode}: {result.stderr.strip()}",
                )


def check_repo_guard_contract(errors, root):
    """Keep the repeated review-time guard honest about logical index state."""
    script = read(root, "scripts/repo_guard")
    for invariant, marker in (
        ("index snapshot", "ls-files --stage -z"),
        ("index-only drift reporting", 'drift+=("index modified: $f")'),
        ("saved index-entry restoration", "update-index -z --index-info"),
        ("dirty-state baseline refusal", "cannot snapshot dirty tracked state without a valid stash baseline"),
        ("legacy stash identification", '"WIP on "*'),
        ("legacy stash index-parent identification", '"index on "*'),
        ("legacy clean-baseline tree", '${baseline}^{tree}'),
        ("ambiguous legacy-baseline refusal", "ambiguous stash-shaped baseline"),
    ):
        if marker not in script:
            fail(errors, "repo-guard-index-contract", "scripts/repo_guard", f"missing {invariant}")

    readme = read(root, "README.md")
    row = next((line for line in readme.splitlines() if line.startswith("| `repo_guard` |")), "")
    if (
        "index's path/mode/object/stage entries" not in row
        or "fails closed" not in row
        or "including merge commits" not in row
        or "stash-create structure" not in row
    ):
        fail(errors, "repo-guard-index-contract", "README.md", "ownership row omits index or baseline behavior")

    protocol = read(root, "skills/panel-review-for-agent/references/protocol.md")
    if (
        "clean baselines (including merges) use their own tree" not in protocol
        or "validated second parent's tree" not in protocol
        or "ambiguous candidates fail closed" not in protocol
    ):
        fail(errors, "repo-guard-index-contract", "protocol.md", "legacy index recovery behavior is missing")


def check_rendered_contracts(errors):
    recognized = {tag for phase in PHASES.values() for tag in phase["required_blocks"]}
    for phase, definition in PHASES.items():
        for panel_size in (2, 3):
            label = f"rendered:{phase}:panel-{panel_size}"
            rendered = render_contract(
                phase,
                panel_size,
                f"/plugin/scripts/check_draft {'findings' if phase == 'round0' else 'stances'}",
            )
            # agy expands a leading slash command in print mode, so each generated prompt must
            # begin with the rendered prose contract.
            if rendered.lstrip().startswith("/"):
                fail(
                    errors,
                    "agy-prompt-prefix",
                    label,
                    "rendered seat contract starts with a slash command",
                )
            if f"configured panel has {panel_size} reviewer seats, including you" not in rendered:
                fail(errors, "configured-panel-wording", label, "panel size is absent or incorrect")
            if "any field or evidence point the parser would discard" not in rendered:
                fail(
                    errors,
                    "pre-emit-loss-diagnostics",
                    label,
                    "the seat instructions do not explain that the validator reports dropped fields and points",
                )
            problem = response_problem(rendered, phase)
            if problem is not None:
                fail(errors, "seat-block-cardinality", label, problem[1])
            for tag in definition["required_blocks"]:
                match = re.search(
                    rf"(?ms)^```{re.escape(tag)}[ \t\r]*$\n(.*?)^```[ \t\r]*$",
                    rendered,
                )
                if match is None:
                    fail(errors, "seat-block-cardinality", label, f"missing rendered `{tag}` example")
                    continue
                raw_items = match.group(1).strip()
                if not raw_items:
                    continue
                for line in raw_items.splitlines():
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        fail(errors, "seat-field-contract", label, f"`{tag}` example is not JSON")
                        continue
                    valid_func, _diagnose_func = get_rules(tag)
                    valid, _normalized_item = valid_func(item)
                    if not valid:
                        fail(errors, "seat-field-contract", label, f"`{tag}` example fails runtime validation")
            for tag in recognized - set(definition["required_blocks"]):
                if re.search(rf"(?m)^```{re.escape(tag)}[ \t\r]*$", rendered):
                    fail(errors, "seat-block-cardinality", label, f"unexpected `{tag}` example")


def check_tree(errors, root):
    check_merge_payload_contract(errors, root)
    check_repo_guard_contract(errors, root)

    templates = {
        "round0": read(root, "prompts/blind_pass.tmpl"),
        "debate": read(root, "prompts/debate.tmpl"),
    }
    for phase, template in templates.items():
        if template.count("{{SEAT_CONTRACT}}") != 1:
            fail(errors, "seat-contract-owner", f"prompts/{phase}", "must contain one SEAT_CONTRACT sentinel")
        # agy expands a leading slash command, so render this prose sentinel before other prompt text.
        if not template.startswith("{{SEAT_CONTRACT}}\n"):
            fail(
                errors,
                "agy-prompt-prefix",
                f"prompts/{phase}",
                "first line must be the SEAT_CONTRACT sentinel",
            )
        if re.search(r"(?m)^```(findings|stances|new_findings)[ \t\r]*$", template):
            fail(errors, "seat-contract-owner", f"prompts/{phase}", "template restates a seat block")
        if template.count("{{PROFILEINFO}}") != 1:
            fail(errors, "review-profile-owner", f"prompts/{phase}", "must contain one PROFILEINFO sentinel")

    owner_map = read(root, "CONTRACTS.md")
    for owner in (
        "scripts/seat_contract.py",
        "scripts/round",
        "scripts/stage_review_profile",
        "scripts/scope_diagnostics",
        "skills/panel-review-for-agent/references/protocol.md",
        "agents/panel-review-cli-barrier.md",
        "scripts/write_verdict_artifact",
        "skills/panel-review-for-agent/SKILL.md",
        "hooks/enforce_agent_status_stub",
    ):
        if owner not in owner_map:
            fail(errors, "contract-ownership-map", "CONTRACTS.md", f"missing owner {owner}")

    protocol = read(root, "skills/panel-review-for-agent/references/protocol.md")
    barrier = read(root, "agents/panel-review-cli-barrier.md")
    referee = read(root, "agents/panel-review-referee.md")
    claude_seat = read(root, "agents/panel-review-claude-seat.md")
    claude_delivery = read(root, "prompts/claude_delivery.tmpl")
    bootstrap = read(root, "skills/panel-review-for-agent/SKILL.md")
    agent_status_hook = read(root, "hooks/enforce_agent_status_stub")
    hook_config = json.loads(read(root, "hooks/hooks.json"))
    status = read(root, "skills/status/SKILL.md")
    commands = {
        name: read(root, f"skills/{name}/SKILL.md")
        for name in ("start", "resume", "continue")
    }
    readme = read(root, "README.md")
    if "agy expands leading slash commands in print mode" not in readme.lower():
        fail(
            errors,
            "agy-slash-command-policy",
            "README.md",
            "does not state that print-mode slash-command expansion stays enabled",
        )
    executable_text = "\n".join([*templates.values(), protocol, referee, bootstrap])
    round0 = normalized(read_protocol_phase(root, "round0"))
    recovery = normalized(read_protocol_phase(root, "recovery"))
    debate = read_protocol_phase(root, "debate")
    verdict = normalized(read_protocol_phase(root, "verdict"))

    for location, text, required in (
        ("rendered:round0", round0, "Retry each still-down seat once"),
        ("rendered:round0", round0, 'prepare-round0 "$id" --retry'),
        ("rendered:round0", round0, "exact saved blind prompt"),
        ("rendered:recovery", recovery, "preserves every complete Round-0 seat pass"),
        ("rendered:recovery", recovery, "currently available seat that remains down"),
        ("rendered:recovery", recovery, 'prepare-round0 "$id" --resume'),
        ("rendered:verdict", verdict, "Round-0 attempt history plus final seat statuses"),
    ):
        if required not in text:
            fail(
                errors,
                "round0-retry-contract",
                location,
                f"missing `{required}` behavior",
            )

    for location, text, required in (
        ("rendered:round0", round0, "non-independent when it copies another seat's distinctive wording"),
        ("rendered:round0", round0, "shared conclusion, location, or conventional phrase alone is not copying"),
        ("rendered:round0", round0, "remove the other co-raiser(s) from `raised_by`"),
        ("rendered:round0", round0, "origins/independence.round0.txt"),
        ("rendered:round0", round0, "filtered Round-0 raiser list for each issue in `/tmp/$id/origins/round0.origins.txt`"),
        ("rendered:debate", normalized(debate), "same-pass raisers and original finding text in `/tmp/$id/origins/epoch-$epoch.round-$round.origins.txt`"),
        ("rendered:verdict", verdict, "report each dropped co-raiser"),
        ("rendered:verdict", verdict, "as a blindness incident"),
        ("rendered:verdict", verdict, "origin record from each issue's birth pass for its \"flagged by\" list"),
        ("rendered:verdict", verdict, "for a Round-0-born issue, use the post-drop raiser list in `/tmp/$id/origins/round0.origins.txt` for both that list and the independent Round-0 support count"),
        ("rendered:verdict", verdict, "for an issue born in debate, use its `epoch-<epoch>.round-<N>.origins.txt` record for \"flagged by\" and report independent Round-0 support as `0`"),
        ("rendered:verdict", verdict, "never count dropped co-raisers or use cumulative `evaluated_by` for the Round-0 support count"),
        ("README.md", normalized(readme), "a copied or near-verbatim finding counts once"),
        ("README.md", normalized(readme), "the verdict's \"flagged by\" list uses each issue's birth-pass origins"),
        ("README.md", normalized(readme), "debate-born issues have zero independent Round-0 support"),
    ):
        if required.lower() not in text.lower():
            fail(
                errors,
                "round0-independence-contract",
                location,
                f"missing `{required}` behavior",
            )

    independence_notice = "A copied Round-0 finding counts once. The referee records any dropped co-raiser"
    for location, text in (
        ("prompts/blind_pass.tmpl", templates["round0"]),
        ("prompts/debate.tmpl", templates["debate"]),
        ("agents/panel-review-claude-seat.md", claude_seat),
    ):
        if independence_notice not in text:
            fail(
                errors,
                "round0-independence-contract",
                location,
                "is missing the copied-finding consequence",
            )

    for location, text, required in (
        ("README.md", normalized(readme), "retry each non-complete batch once"),
        ("rendered:debate", normalized(debate), "Retry every non-complete batch once"),
    ):
        if required.lower() not in text.lower():
            fail(
                errors,
                "debate-retry-contract",
                location,
                f"missing `{required}` behavior",
            )

    if "if it finds index.phase=round0 load round0 too" not in normalized(bootstrap):
        fail(
            errors,
            "round0-retry-contract",
            "skills/panel-review-for-agent/SKILL.md",
            "resume bootstrap does not load the Round-0 phase for Round-0 recovery",
        )

    for name, command in commands.items():
        dispatches = [
            block
            for block in re.findall(r"(?ms)^```[^\n]*\n(.*?)^```[ \t]*$", command)
            if "subagent_type: panel-review:panel-review-referee" in block
        ]
        if not dispatches or any("run_in_background: false" not in block for block in dispatches):
            fail(
                errors,
                "outer-referee-agent-contract",
                f"skills/{name}/SKILL.md",
                "every referee Agent dispatch must set run_in_background: false",
            )
        command_text = normalized(command)
        if "background helper Agent" in command_text:
            fail(
                errors,
                "outer-referee-agent-contract",
                f"skills/{name}/SKILL.md",
                "uses the retired background-helper description",
            )
        for required in (
            "Subagent spawn limit reached",
            "do not perform the referee's work",
            "do not retry the Agent call",
            "Leave the run intact",
            "stop here without applying",
            "/clear",
            "panel-review:resume",
        ):
            if required not in command_text:
                fail(
                    errors,
                    "agent-spawn-budget",
                    f"skills/{name}/SKILL.md",
                    f"missing `{required}` handling",
                )

    if "Step 4 form" not in commands["start"].partition("**Await its single return")[2]:
        fail(
            errors,
            "outer-referee-agent-contract",
            "skills/start/SKILL.md",
            "low-severity re-dispatch does not reuse the foreground Step 4 form",
        )

    start_delivery = normalized(commands["start"].partition("## Step 5")[2])
    for required in (
        "PANEL_REVIEW_FAILED",
        "fixed status does not disclose",
        "start a fresh conversation",
        "every other returned status or Agent-tool failure",
        "/clear",
        "panel-review:resume",
    ):
        if required not in start_delivery:
            fail(
                errors,
                "agent-spawn-budget",
                "skills/start/SKILL.md",
                f"shared delivery flow is missing `{required}` propagation",
            )

    bootstrap_text = normalized(bootstrap)
    bootstrap_lower = bootstrap_text.lower()
    for required in (
        "subagent spawn limit reached",
        "do not perform the missing agent's work",
        "do not retry either agent call",
        "do not treat this as an ordinary down-seat pass",
        "leave the current checkpoint intact",
        "panel_review_failed",
    ):
        if required not in bootstrap_lower:
            fail(
                errors,
                "agent-spawn-budget",
                "skills/panel-review-for-agent/SKILL.md",
                f"missing `{required}` handling",
            )

    barrier_text = normalized(barrier)
    barrier_lower = barrier_text.lower()
    for required in (
        "2 minutes by default",
        "10-minute maximum",
        "moves the call to the background instead of stopping it",
        "explicitly backgrounds `await_seats`",
        "timeout` parameter to `2700000` ms (45 minutes)",
        "owns the launch and completion-sentinel lifecycle",
        "before the bash tool can auto-background the wait",
    ):
        if required not in barrier_lower:
            fail(
                errors,
                "bash-timeout-contract",
                "agents/panel-review-cli-barrier.md",
                f"missing `{required}` behavior",
            )
    for stale in ("killed by the harness", "would be killed", "silently truncated"):
        if stale in barrier_lower:
            fail(
                errors,
                "bash-timeout-contract",
                "agents/panel-review-cli-barrier.md",
                f"retains stale `{stale}` wording",
            )

    run_seat_match = re.search(r"(?m)^\| `run_seat` \|.*$", readme)
    if run_seat_match is None:
        fail(errors, "bash-timeout-contract", "README.md", "missing run_seat ownership row")
    else:
        run_seat_row = run_seat_match.group(0).lower()
        if "panel-review-cli-barrier" not in run_seat_row:
            fail(errors, "bash-timeout-contract", "README.md", "run_seat row does not point to the barrier")
        for stale in ("killed", "empty raw"):
            if stale in run_seat_row:
                fail(
                    errors,
                    "bash-timeout-contract",
                    "README.md",
                    f"run_seat row retains stale `{stale}` wording",
                )

    readme_lower = normalized(readme).lower()
    if "scope_diagnostics" not in readme:
        fail(errors, "divergence-diagnostics", "README.md", "does not name the diagnostics owner")
    divergence_docs = {
        "README.md": readme_lower,
        "skills/panel-review-for-agent/references/protocol.md": normalized(protocol).lower(),
    }
    for location, text in divergence_docs.items():
        for required in (".git/info/exclude", "saved diff hash", "tracked `.gitignore`"):
            if required not in text:
                fail(errors, "divergence-recovery", location, f"is missing `{required}` guidance")
    if "only way forward" in readme_lower:
        fail(errors, "divergence-recovery", "README.md", "still presents discard as the only recovery")
    for required in (
        "subagent spawn limit reached",
        "not a down-seat pass",
        "/clear",
        "panel-review:resume",
    ):
        if required not in readme_lower:
            fail(
                errors,
                "agent-spawn-budget",
                "README.md",
                f"public recovery guidance is missing `{required}`",
            )

    forbidden_debate_commands = (
        (r'\$SC/merge_payload\b', "merge_payload"),
        (r'\$SC/sweep"?[ \t]+commit\b', "sweep commit"),
    )
    for pattern, command in forbidden_debate_commands:
        if re.search(pattern, debate):
            fail(
                errors,
                "normal-debate-transaction-owner",
                "rendered:debate",
                f"directly invokes {command} instead of round commit",
            )
    decision_command = '"$SC/round" commit "$id"'
    if decision_command not in debate:
        fail(
            errors,
            "normal-debate-transaction-owner",
            "rendered:debate",
            "does not invoke round commit",
        )
    post_decision = debate.partition(decision_command)[2]
    if re.search(r'\$SC/regen_cards\b', post_decision):
        fail(
            errors,
            "normal-debate-transaction-owner",
            "rendered:debate",
            "directly invokes post-decision regen_cards instead of round commit",
        )

    if re.search(r"(?i)`(findings|stances|new_findings)` block|required-emptyable", claude_seat):
        fail(errors, "seat-contract-owner", "agents/panel-review-claude-seat.md", "restates phase block rules")
    if "`stances`" in claude_delivery or "`new_findings`" in claude_delivery:
        fail(errors, "seat-contract-owner", "prompts/claude_delivery.tmpl", "restates phase block names")

    for relative, text in (
        ("protocol.md", protocol),
        ("panel-review-cli-barrier.md", barrier),
    ):
        for sentence in re.split(r"[.\n]", normalized(text)):
            lowered = sentence.lower()
            if "watch" in lowered and "--done" in lowered and "sentinel" not in lowered:
                fail(errors, "barrier-completion-signal", relative, "treats --done as the wait signal")

    if re.search(r"(?i)(scratch )?path is \**relative\**|relative (scratch|seat) path", normalized(protocol)):
        fail(errors, "absolute-seat-paths", "protocol.md", "describes a seat path as relative")

    broad_failure = re.compile(
        r"(?is)(PANEL_VERDICT_WRITE_FAILED.{0,100}(any|general|review) failure|"
        r"(any|general|review) failure.{0,100}PANEL_VERDICT_WRITE_FAILED)"
    )
    if broad_failure.search(referee + "\n" + bootstrap + "\n" + protocol):
        fail(errors, "referee-return-status", "referee contracts", "write failure stub is used for a review failure")
    for status_name in ("PANEL_VERDICT_READY", "PANEL_VERDICT_WRITE_FAILED", "PANEL_REVIEW_FAILED"):
        if status_name not in bootstrap:
            fail(errors, "referee-return-status", "bootstrap skill", f"missing {status_name}")
        if status_name in referee or status_name in protocol:
            fail(errors, "referee-return-status", "non-owner referee instructions", f"restate {status_name}")
        if status_name not in agent_status_hook:
            fail(errors, "referee-return-status", "Agent status hook", f"does not enforce {status_name}")
    for status_name in ("CLAUDE_SEAT_RAW_WRITTEN", "CLAUDE_SEAT_RAW_FAILED"):
        if status_name not in claude_delivery:
            fail(errors, "claude-return-status", "Claude delivery prompt", f"missing {status_name}")
        if status_name not in agent_status_hook:
            fail(errors, "claude-return-status", "Agent status hook", f"does not enforce {status_name}")

    pretool_groups = hook_config.get("hooks", {}).get("PreToolUse", [])
    if not any(group.get("matcher") == "SubagentHandback" for group in pretool_groups):
        fail(
            errors,
            "auto-handback-status-gate",
            "hooks/hooks.json",
            "missing SubagentHandback PreToolUse hook",
        )
    if 'event_name == "PreToolUse"' not in agent_status_hook:
        fail(
            errors,
            "auto-handback-status-gate",
            "Agent status hook",
            "does not validate PreToolUse hand-backs",
        )
    if 'payload.get("permission_mode") == "auto"' not in agent_status_hook:
        fail(
            errors,
            "auto-handback-status-gate",
            "Agent status hook",
            "does not distinguish auto-mode closing text",
        )
    for required in (
        "def deny_first_invalid_handback(payload):",
        "def set_handback_state(payload, state):",
        "def read_handback_state(payload):",
        "def terminal_failure_status(agent_type, message, transcript_path):",
        'handback_state != "accepted"',
        "is_exact_referee_failure_stub(message)",
        'UNKNOWN_RUN_ID = "unavailable"',
        '"updatedInput": {"message": terminal_message}',
    ):
        if required not in agent_status_hook:
            fail(
                errors,
                "auto-handback-retry-bound",
                "Agent status hook",
                f"missing bounded failure behavior `{required}`",
            )
    bounded_handback = (
        "The hook denies at most one invalid hand-back per subagent; if retry state is unavailable "
        "or a later hand-back is still invalid, it replaces the message with a fixed failure stub "
        "and allows it."
    )
    missing_run_id_fallback = (
        "If the referee task ID and an exact stub ID are both unavailable, the hook uses"
    )
    pending_denial_stop_check = (
        "If no accepted auto-mode hand-back is recorded, SubagentStop checks the final message itself."
    )
    for relative, text in (("README.md", readme), ("protocol.md", protocol)):
        text = normalized(text.replace("`", ""))
        for required in (bounded_handback, missing_run_id_fallback, pending_denial_stop_check):
            if required not in text:
                fail(
                    errors,
                    "auto-handback-retry-bound",
                    relative,
                    f"missing `{required}`",
                )

    if re.search(r"(?i)two other AIs", executable_text):
        fail(errors, "configured-panel-wording", "seat-facing instructions", "hard-codes a three-seat panel")

    if re.search(r"(?i)peer seat \(Codex or Gemini\) down", normalized(protocol)):
        fail(errors, "all-seat-health-reporting", "protocol.md", "excludes Claude from down-seat notes")

    if re.search(r"(?i)(verdict.{0,80})?shown in the transcript", normalized(status)):
        fail(errors, "artifact-only-status-wording", "skills/status/SKILL.md", "claims the verdict body entered the transcript")

    if "support_with_revision" in executable_text:
        fail(errors, "canonical-stance-values", "executable instructions", "contains retired stance support_with_revision")

    # agy binds --model by DISPLAY LABEL ("Gemini 3.7 Flash (High)"), and a slug is not a stable
    # identifier across agy versions: on 1.1.10 the listed slug `gemini-3.1-pro-high` bound
    # Gemini 3.6 Flash (High) instead. How a bad value fails is version-dependent too (1.1.10 ran
    # the user's settings.json model with no error), so a slug substitution can downgrade a review
    # seat invisibly. Shape-check both pins here; `tests/live/agy_model_binding.sh` is the on-demand
    # proof that a pin actually binds, which only the installed CLI can answer.
    run_agy = read(root, "scripts/run_agy")
    display_label = re.compile(r"^Gemini [0-9]+(?:\.[0-9]+)* [A-Z][A-Za-z-]* \((?:High|Medium|Low)\)$")
    pins = {}
    for pin_name in ("PRIMARY_MODEL", "FALLBACK_MODEL"):
        match = re.search(rf'(?m)^{pin_name}="([^"]*)"$', run_agy)
        if match is None:
            fail(errors, "agy-model-pin-form", "scripts/run_agy", f"{pin_name} pin not found")
            continue
        pins[pin_name] = match.group(1)
        if not display_label.match(pins[pin_name]):
            fail(
                errors,
                "agy-model-pin-form",
                "scripts/run_agy",
                f"{pin_name} is not an agy display label (slug?): {pins[pin_name]!r}",
            )
    # A fallback identical to the primary is not a fallback: the retry would re-run the model that
    # just failed. The label shape above already keeps both pins on Gemini, never agy's
    # Claude/GPT-OSS entries.
    if len(pins) == 2 and pins["PRIMARY_MODEL"] == pins["FALLBACK_MODEL"]:
        fail(errors, "agy-model-pin-form", "scripts/run_agy", "fallback pin equals the primary pin")


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args(argv)
    errors = []
    try:
        check_rendered_contracts(errors)
        check_tree(errors, args.root.resolve())
    except RuntimeError as error:
        print(f"contract-check-setup: {error}", file=sys.stderr)
        return 2
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1
    print("instruction contracts: OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
