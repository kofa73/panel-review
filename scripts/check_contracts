#!/usr/bin/env python3
"""Check executable-instruction ownership and rendered seat contracts."""

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile

from seat_contract import PHASES, get_rules, render_contract, response_problem


def fail(errors, invariant, location, detail):
    errors.append(f"{invariant}: {location}: {detail}")


def read(root, relative):
    path = root / relative
    try:
        return path.read_text(encoding="utf-8")
    except OSError as error:
        raise RuntimeError(f"cannot read {relative}: {error}") from error


def read_protocol_phase(root, phase):
    reader = root / "scripts" / "read_protocol_phase"
    try:
        result = subprocess.run(
            [str(reader), phase],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as error:
        raise RuntimeError(f"cannot render protocol phase {phase}: {error}") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"cannot render protocol phase {phase}: {detail}")
    return result.stdout


def fenced_blocks(text, language):
    return re.findall(
        rf"(?ms)^[ \t]*```{re.escape(language)}[ \t]*\n(.*?)^[ \t]*```[ \t]*$",
        text,
    )


def instruction_code(text):
    pattern = re.compile(
        r"^[ \t]*```bash[ \t]*\n(?P<fenced>.*?)^[ \t]*```[ \t]*$"
        r"|(?<!`)`(?P<inline>[^`\n]+)`(?!`)",
        re.MULTILINE | re.DOTALL,
    )
    return [match.group("fenced") or match.group("inline") for match in pattern.finditer(text)]


def markdown_bullet_section(text, label):
    """Return one command-skill bullet and its nested instructions, if present."""
    start = text.find(label)
    if start < 0:
        return None
    following = re.search(r"(?m)^\s*-\s+\*\*", text[start + len(label) :])
    end = start + len(label) + following.start() if following else len(text)
    return text[start:end]


def contains_run_deletion_instruction(text):
    code = "\n".join(instruction_code(text))
    return bool(re.search(r"\$SC/cleanup\b|\brm\s+-rf\b", code))


def check_stale_run_handoffs(errors, root):
    """Stale entrypoints preserve possibly recoverable state for an explicit decision."""
    labels = {
        "start": "- **`stale`**",
        "resume": "- **`stale $id`**",
        "continue": "- **`stale $id`**",
    }
    for name, label in labels.items():
        relative = f"skills/{name}/SKILL.md"
        skill = read(root, relative)
        branch = markdown_bullet_section(skill, label)
        if branch is None:
            fail(errors, "stale-run-handoff", relative, "missing stale-state branch")
            continue
        if contains_run_deletion_instruction(branch):
            fail(
                errors,
                "stale-run-handoff",
                relative,
                "stale-state branch can delete the run before explicit recovery or discard",
            )

    resume = read(root, "skills/resume/SKILL.md")
    manifest_step = resume.partition("## Step 3")[2].partition("## Step 4")[0]
    if contains_run_deletion_instruction(manifest_step):
        fail(
            errors,
            "stale-run-handoff",
            "skills/resume/SKILL.md",
            "missing-manifest guard can delete the run before explicit recovery or discard",
        )


def redefines_seat_blocks(text, include_inline_tokens=False):
    block_names = r"(?:findings|stances|new_findings)"
    return bool(
        re.search(rf"(?m)^[ \t]*```{block_names}[ \t\r]*$", text)
        or (
            include_inline_tokens
            and re.search(rf"(?<!`)`{block_names}`(?!`)", text)
        )
    )


def check_merge_payload_contract(errors, root):
    """Probe the addendum boundary so misspellings and consumed-field shapes fail closed."""
    script = root / "scripts" / "merge_payload"
    if not script.is_file():
        fail(errors, "merge-payload-validation", "scripts/merge_payload", "script is missing")
        return

    probes = [
        ({}, {"add_issue": []}, 'addendum has unknown key "add_issue"'),
        ({}, {"add_evidence": {}}, "addendum .add_evidence is not a list"),
        ({}, {"add_issues": "oops"}, "addendum .add_issues is not a list"),
        ({}, {"evaluated_by": "x"}, "addendum .evaluated_by is not an object"),
        ({"evaluated_by": "x"}, {}, "base .evaluated_by is not an object"),
    ]
    for key, expected in (
        ("add_evidence", "is not a list"),
        ("add_issues", "is not a list"),
        ("evaluated_by", "is not an object"),
    ):
        for invalid_value in (None, False):
            detail = f".{key} {expected}"
            probes.append(({}, {key: invalid_value}, f"addendum {detail}"))
            probes.append(({key: invalid_value}, {}, f"base {detail}"))
    with tempfile.TemporaryDirectory(prefix="panel-contract-merge-") as directory:
        base_path = Path(directory) / "base.json"
        for base, addendum, expected in probes:
            base_path.write_text(json.dumps(base), encoding="utf-8")
            try:
                result = subprocess.run(
                    [sys.executable, str(script), str(base_path)],
                    input=json.dumps(addendum),
                    capture_output=True,
                    text=True,
                    check=False,
                )
            except OSError as error:
                fail(errors, "merge-payload-validation", "scripts/merge_payload", str(error))
                return
            if result.returncode != 2 or expected not in result.stderr or "Traceback" in result.stderr:
                fail(
                    errors,
                    "merge-payload-validation",
                    "scripts/merge_payload",
                    f"expected exit 2 with `{expected}` and no traceback; got exit {result.returncode}: {result.stderr.strip()}",
                )


def check_repo_guard_contract(errors, root):
    """Keep the repeated review-time guard honest about logical index state."""
    script = read(root, "scripts/repo_guard")
    for invariant, marker in (
        ("index snapshot", "ls-files --stage -z"),
        ("index-only drift reporting", 'drift+=("index modified: $f")'),
        ("saved index-entry restoration", "update-index -z --index-info"),
        ("dirty-state baseline refusal", "cannot snapshot dirty tracked state without a valid stash baseline"),
        ("legacy stash identification", '"WIP on "*'),
        ("legacy stash index-parent identification", '"index on "*'),
        ("legacy clean-baseline tree", '${baseline}^{tree}'),
        ("ambiguous legacy-baseline refusal", "ambiguous stash-shaped baseline"),
    ):
        if marker not in script:
            fail(errors, "repo-guard-index-contract", "scripts/repo_guard", f"missing {invariant}")


def check_card_cache_contract(errors, root):
    """Keep projected cards disposable and remove stale files before rendering."""
    renderer = read(root, "scripts/project_card")
    if "<!-- panel " in renderer:
        fail(errors, "card-cache-projection", "scripts/project_card", "projected cards contain a metadata header")

    regeneration = read(root, "scripts/regen_cards")
    cleanup = regeneration.find('rm -f -- "$card"')
    render = regeneration.find('"$here/project_card"')
    if cleanup < 0 or render < 0 or cleanup > render:
        fail(
            errors,
            "card-cache-projection",
            "scripts/regen_cards",
            "stale cards must be removed before current cards are rendered",
        )


def check_session_launcher_contract(errors, root):
    """Keep session startup delegated to preflight and package the launcher with the plugin."""
    relative = "bin/panel-review-session"
    path = root / relative
    if not path.is_file():
        fail(errors, "session-launcher-contract", relative, "launcher is missing")
        return
    if not path.stat().st_mode & 0o111:
        fail(errors, "session-launcher-contract", relative, "launcher is not executable")

    launcher = read(root, relative)
    for marker, invariant in (
        ('"$plugin_root/scripts/preflight"', "runs the shared preflight"),
        ("CLAUDE_CODE_FORK_SUBAGENT=0", "sets fork mode off for this session"),
        ('exec claude "$@"', "execs Claude with the caller arguments"),
        (".panel-review", "reports saved review markers"),
        ('[ -f "$marker/.panel-run" ] || continue', "ignores directories without a run marker"),
    ):
        if marker not in launcher:
            fail(errors, "session-launcher-contract", relative, f"must {invariant}")

    duplicate_checks = (
        "command -v jq",
        "command -v git",
        "git rev-parse --is-inside-work-tree",
        "no peer seat available",
        '[ -w "." ]',
    )
    for marker in duplicate_checks:
        if marker in launcher:
            fail(errors, "session-launcher-contract", relative, f"duplicates a preflight check: {marker}")

    installer = read(root, "install.sh")
    copied_parts = installer.partition("for part in")[2].partition("; do")[0]
    if not re.search(r"\bbin\b", copied_parts):
        fail(errors, "session-launcher-contract", "install.sh", "must copy the bin directory")

    readme = read(root, "README.md")
    if "panel-review-session" not in readme or ".panel-run" not in readme:
        fail(errors, "session-launcher-contract", "README.md", "must document the launcher and its run marker")
    protocol_path = "skills/panel-review-for-agent/references/protocol.md"
    if ".panel-run" not in read(root, protocol_path):
        fail(errors, "session-launcher-contract", protocol_path, "must name the run-marker file retained by stale-run handoff")
    scripts_rule = read(root, ".claude/rules/scripts.md")
    if relative not in scripts_rule:
        fail(errors, "session-launcher-contract", ".claude/rules/scripts.md", "must document launcher ownership")


def check_retired_script_surface(errors, root):
    """Keep retired verbs out of the public CLI and model-facing command inventory."""
    command_lists = {}
    for relative, retired in (
        ("scripts/index", {"bump", "state", "flag"}),
        ("scripts/sweep", {"record"}),
    ):
        try:
            result = subprocess.run(
                [str(root / relative), "--help"],
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError as error:
            fail(errors, "retired-script-surface", relative, f"cannot read command list: {error}")
            continue
        usage = result.stdout.strip()
        match = re.search(r"\{([^}]+)\}", usage)
        if result.returncode != 0 or match is None:
            fail(errors, "retired-script-surface", relative, "help does not expose its command list")
            continue
        exposed = set(match.group(1).split("|"))
        remaining = exposed & retired
        if remaining:
            fail(
                errors,
                "retired-script-surface",
                relative,
                f"help still exposes retired command(s): {', '.join(sorted(remaining))}",
            )

        # These verbs remain script internals for round's transaction. Listing them in model-facing
        # protocol instructions makes it easy to bypass that owner even though the CLI still has them.
        name = relative.rsplit("/", 1)[-1]
        internal = {"index": {"commit-sweep"}, "sweep": {"commit"}}.get(name, set())
        command_lists[name] = exposed - internal

    protocol = read(root, "skills/panel-review-for-agent/references/protocol.md")
    for name, exposed in command_lists.items():
        command_line = next(
            (line for line in protocol.splitlines() if f'"$SC/{name}"' in line and "{" in line),
            "",
        )
        match = re.search(r"\{([^}]+)\}", command_line)
        if match is None or set(match.group(1).split("|")) != exposed:
            fail(
                errors,
                "retired-script-surface",
                "skills/panel-review-for-agent/references/protocol.md",
                f"{name} command list does not match its CLI help",
            )

    installer = read(root, "install.sh")
    if "for old_skill in" in installer or "for old_agent in" in installer:
        fail(errors, "retired-script-surface", "install.sh", "still removes the obsolete loose layout")


def check_shared_python_helper_ownership(errors, root):
    """Keep migrated schema, fence, and stance checks behind their shared owner."""
    shared = read(root, "scripts/panel_common.py")
    for relative, markers, invariant in (
        (
            "scripts/birth_index",
            ("CATEGORIES", "SEVERITIES", "valid_location", "valid_point"),
            "shared-point-validation",
        ),
        (
            "scripts/parse_block",
            ("extract_fenced_block",),
            "shared-fence-scan",
        ),
        (
            "scripts/extract_block",
            ("extract_fenced_block",),
            "shared-fence-scan",
        ),
        (
            "scripts/decide_round",
            ("stance_integrity_problems",),
            "shared-stance-integrity",
        ),
        (
            "scripts/decide_degraded_round",
            ("stance_integrity_problems",),
            "shared-stance-integrity",
        ),
    ):
        consumer = read(root, relative)
        for marker in markers:
            if marker not in shared or marker not in consumer:
                fail(errors, invariant, relative, f"must use panel_common.py helper {marker}")

    parser = read(root, "scripts/parse_block")
    if "subprocess.run" in parser or "extract_block" in parser:
        fail(
            errors,
            "shared-fence-scan",
            "scripts/parse_block",
            "must scan through panel_common.py without spawning the CLI shim",
        )


def check_rendered_contracts(errors):
    recognized = {tag for phase in PHASES.values() for tag in phase["required_blocks"]}
    for phase, definition in PHASES.items():
        for panel_size in (2, 3):
            label = f"rendered:{phase}:panel-{panel_size}"
            rendered = render_contract(
                phase,
                panel_size,
                f"/plugin/scripts/check_draft {'findings' if phase == 'round0' else 'stances'}",
            )
            # agy expands a leading slash command in print mode, so each generated prompt must
            # begin with the rendered prose contract.
            if rendered.lstrip().startswith("/"):
                fail(
                    errors,
                    "agy-prompt-prefix",
                    label,
                    "rendered seat contract starts with a slash command",
                )
            problem = response_problem(rendered, phase)
            if problem is not None:
                fail(errors, "seat-block-cardinality", label, problem[1])
            for tag in definition["required_blocks"]:
                match = re.search(
                    rf"(?ms)^```{re.escape(tag)}[ \t\r]*$\n(.*?)^```[ \t\r]*$",
                    rendered,
                )
                if match is None:
                    fail(errors, "seat-block-cardinality", label, f"missing rendered `{tag}` example")
                    continue
                raw_items = match.group(1).strip()
                if not raw_items:
                    continue
                for line in raw_items.splitlines():
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        fail(errors, "seat-field-contract", label, f"`{tag}` example is not JSON")
                        continue
                    valid_func, _diagnose_func = get_rules(tag)
                    valid, _normalized_item = valid_func(item)
                    if not valid:
                        fail(errors, "seat-field-contract", label, f"`{tag}` example fails runtime validation")
            for tag in recognized - set(definition["required_blocks"]):
                if re.search(rf"(?m)^```{re.escape(tag)}[ \t\r]*$", rendered):
                    fail(errors, "seat-block-cardinality", label, f"unexpected `{tag}` example")


def check_tree(errors, root):
    check_merge_payload_contract(errors, root)
    check_repo_guard_contract(errors, root)
    check_card_cache_contract(errors, root)
    check_session_launcher_contract(errors, root)
    check_retired_script_surface(errors, root)
    check_stale_run_handoffs(errors, root)
    check_shared_python_helper_ownership(errors, root)

    templates = {
        "round0": read(root, "prompts/blind_pass.tmpl"),
        "debate": read(root, "prompts/debate.tmpl"),
    }
    required_sentinels = {
        "round0": ("SCOPE", "WORKDIR", "SCRATCH", "DIFFINFO", "INSTRUCTIONS", "TILTH"),
        "debate": ("WORKDIR", "SCRATCH", "CARDS", "INSTRUCTIONS", "TILTH"),
    }
    for phase, template in templates.items():
        if template.count("{{SEAT_CONTRACT}}") != 1:
            fail(errors, "seat-contract-owner", f"prompts/{phase}", "must contain one SEAT_CONTRACT sentinel")
        # agy expands a leading slash command, so render this prose sentinel before other prompt text.
        if not template.startswith("{{SEAT_CONTRACT}}\n"):
            fail(
                errors,
                "agy-prompt-prefix",
                f"prompts/{phase}",
                "first line must be the SEAT_CONTRACT sentinel",
            )
        if redefines_seat_blocks(template):
            fail(errors, "seat-contract-owner", f"prompts/{phase}", "template restates a seat block")
        if template.count("{{PROFILEINFO}}") != 1:
            fail(errors, "review-profile-owner", f"prompts/{phase}", "must contain one PROFILEINFO sentinel")
        for sentinel in required_sentinels[phase]:
            placeholder = f"{{{{{sentinel}}}}}"
            if template.count(placeholder) != 1:
                fail(
                    errors,
                    "prompt-template-sentinel",
                    f"prompts/{phase}",
                    f"must contain one {placeholder} sentinel",
                )
    if "{{DIFF}}" in templates["round0"]:
        fail(errors, "prompt-template-sentinel", "prompts/blind_pass.tmpl", "must reference the external diff")

    owner_map = read(root, "CONTRACTS.md")
    for owner in (
        "scripts/seat_contract.py",
        "scripts/panel_common.py",
        "scripts/round",
        "scripts/stage_review_profile",
        "scripts/user_config.py",
        "scripts/scope_diagnostics",
        "skills/panel-review-for-agent/references/protocol.md",
        "agents/panel-review-cli-barrier.md",
        "scripts/write_verdict_artifact",
        "scripts/write_card",
        "skills/panel-review-for-agent/SKILL.md",
        "hooks/enforce_agent_status_stub",
        "bin/panel-review-session",
    ):
        if owner not in owner_map:
            fail(errors, "contract-ownership-map", "CONTRACTS.md", f"missing owner {owner}")

    protocol = read(root, "skills/panel-review-for-agent/references/protocol.md")
    barrier = read(root, "agents/panel-review-cli-barrier.md")
    referee = read(root, "agents/panel-review-referee.md")
    claude_seat = read(root, "agents/panel-review-claude-seat.md")
    claude_delivery = read(root, "prompts/claude_delivery.tmpl")
    bootstrap = read(root, "skills/panel-review-for-agent/SKILL.md")
    agent_status_hook = read(root, "hooks/enforce_agent_status_stub")
    hook_config = json.loads(read(root, "hooks/hooks.json"))
    round_script = read(root, "scripts/round")
    user_config = read(root, "scripts/user_config.py")
    init_run = read(root, "scripts/init_run")
    cleanup_script = read(root, "scripts/cleanup")
    discard_script = read(root, "scripts/discard")
    await_seats = read(root, "scripts/await_seats")
    commands = {
        name: read(root, f"skills/{name}/SKILL.md")
        for name in ("start", "resume", "continue")
    }
    debate = read_protocol_phase(root, "debate")

    for name in ("resume", "continue"):
        command = commands[name]
        update_guard = re.search(
            r'(?ms)^"\$SC/set_limits" "\$\{SETTING_ARGS\[@\]\}" \|\| \{\n(.*?)^\}',
            command,
        )
        dispatch_at = command.find("subagent_type: panel-review:panel-review-referee")
        reopen_at = command.find('"$SC/reopen"') if name == "continue" else -1
        if (
            update_guard is None
            or "exit 1" not in update_guard.group(1)
            or dispatch_at < 0
            or update_guard.start() > dispatch_at
            or (reopen_at >= 0 and update_guard.start() > reopen_at)
        ):
            fail(
                errors,
                "saved-setting-update-guard",
                f"skills/{name}/SKILL.md",
                "must stop on set_limits failure before reopening or dispatching the saved run",
            )

    for required in (
        "XDG_CONFIG_HOME",
        'base / "panel-review" / "config.json"',
        "ALLOWED_ROOT_KEYS",
        "MAX_SEAT_TIMEOUT_SECONDS",
        "defaults.review_profile",
        "cleanup.keep_tmp",
        "reject_legacy_environment",
        "saved_limits",
    ):
        if required not in user_config:
            fail(
                errors,
                "user-config-owner",
                "scripts/user_config.py",
                f"missing config behavior `{required}`",
            )
    if '"$here/user_config.py" resolve-start' not in init_run:
        fail(errors, "user-config-owner", "scripts/init_run", "does not resolve start settings")
    resolve_at = init_run.find('"$here/user_config.py" resolve-start')
    create_at = init_run.find('mkdir "/tmp/$id"')
    if create_at >= 0 and resolve_at > create_at:
        fail(errors, "user-config-owner", "scripts/init_run", "resolves config after claiming run state")
    for name, script in (("cleanup", cleanup_script), ("discard", discard_script)):
        operational_lines = "\n".join(
            line for line in script.splitlines() if not line.lstrip().startswith("#")
        )
        policy_at = operational_lines.find('"$here/user_config.py" cleanup-policy')
        delete_at = operational_lines.find("rm -rf")
        if policy_at < 0 or (delete_at >= 0 and policy_at > delete_at):
            fail(
                errors,
                "cleanup-config-before-delete",
                f"scripts/{name}",
                "must validate the current config before deleting state",
            )
    if "user_config import ConfigError, saved_limits" not in round_script or '"--seat-timeout"' not in round_script:
        fail(errors, "saved-seat-timeout-owner", "scripts/round", "does not pass saved timeout to barriers")
    if "PANEL_REVIEW_SEAT_TIMEOUT" in await_seats:
        fail(errors, "saved-seat-timeout-owner", "scripts/await_seats", "reads inherited timeout state")

    for marker in ('panel_atomic_write(str(directory / "diff_info.txt")', '"DIFFINFO": directory / "diff_info.txt"'):
        if marker not in round_script:
            fail(
                errors,
                "diff-reference-assembly",
                "scripts/round",
                f"does not create and pass the external diff reference ({marker})",
            )

    protocol_commands = "\n".join(instruction_code(protocol))
    for pattern, command in (
        (r'\$SC/merge_payload\b', "merge_payload"),
        (r'\$SC/index"?[ \t]+commit-sweep\b', "index commit-sweep"),
        (r'\$SC/sweep"?[ \t]+commit\b', "sweep commit"),
        (r'\$SC/decide_(?:degraded_)?round\b', "direct decision helper"),
    ):
        if re.search(pattern, protocol_commands):
            fail(
                errors,
                "model-instruction-transaction-owner",
                "protocol.md",
                f"direct command example exposes internal {command}",
            )

    round0 = read_protocol_phase(root, "round0")
    recovery = read_protocol_phase(root, "recovery")
    for phase, instructions, attempt in (
        ("round0", round0, "--retry"),
        ("recovery", recovery, "--resume"),
    ):
        commands_in_phase = "\n".join(instruction_code(instructions))
        if not re.search(
            rf'"\$SC/round"\s+prepare-round0\s+"\$id"\s+{re.escape(attempt)}(?:\s|$)',
            commands_in_phase,
        ):
            fail(
                errors,
                "round0-prepare-command-shape",
                f"rendered:{phase}",
                f"must invoke prepare-round0 with {attempt}",
            )

    for name, command in commands.items():
        dispatches = [
            block
            for block in re.findall(r"(?ms)^```[^\n]*\n(.*?)^```[ \t]*$", command)
            if re.search(r"(?m)^subagent_type:", block)
        ]
        if not dispatches or any(
            "subagent_type: panel-review:panel-review-referee" not in block
            or "run_in_background: false" not in block
            for block in dispatches
        ):
            fail(
                errors,
                "outer-referee-agent-contract",
                f"skills/{name}/SKILL.md",
                "every Agent dispatch must target the referee and set run_in_background: false",
            )
        if not re.search(r'\$SC/read_verdict_artifact["`]?[ \t\n]+--delivery\b', command):
            fail(
                errors,
                "public-artifact-delivery",
                f"skills/{name}/SKILL.md",
                "does not validate delivery through read_verdict_artifact --delivery",
            )

    for field in (
        "subagent_type: panel-review:panel-review-claude-seat",
        "subagent_type: panel-review:panel-review-cli-barrier",
        "run_in_background: false",
    ):
        if field not in protocol:
            fail(
                errors,
                "inner-seat-agent-dispatch",
                "protocol.md",
                f"is missing Agent dispatch field `{field}`",
            )

    frontmatter = re.match(r"(?s)^---\s*\n(.*?)\n---(?:\s|$)", claude_seat)
    tools_line = re.search(r"(?m)^tools:\s*(.*)$", frontmatter.group(1)) if frontmatter else None
    if (
        tools_line is None
        or "mcp__tilth__tilth_search" not in tools_line.group(1)
        or "mcp__tilth__tilth_write" in tools_line.group(1)
    ):
        fail(
            errors,
            "claude-seat-tool-surface",
            "agents/panel-review-claude-seat.md",
            "tool frontmatter must expose read-only tilth search without a write tool",
        )

    debate_shell = "\n".join(instruction_code(debate))
    for operation in ("prepare-debate", "collect-debate"):
        if not re.search(rf'"\$SC/round"\s+{operation}\b', debate_shell):
            fail(
                errors,
                "normal-debate-transaction-owner",
                "rendered:debate",
                f"common single-batch path omits round {operation}",
            )

    forbidden_debate_commands = (
        (r'\$SC/merge_payload\b', "merge_payload"),
        (r'\$SC/sweep"?[ \t]+commit\b', "sweep commit"),
        (r'\$SC/index"?[ \t]+commit-sweep\b', "index commit-sweep"),
        (r'\$SC/decide_(?:degraded_)?round\b', "direct decision helper"),
    )
    for pattern, command in forbidden_debate_commands:
        if re.search(pattern, debate_shell):
            fail(
                errors,
                "normal-debate-transaction-owner",
                "rendered:debate",
                f"directly invokes {command} instead of round commit",
            )
    decision_command = '"$SC/round" commit "$id"'
    if decision_command not in debate_shell:
        fail(
            errors,
            "normal-debate-transaction-owner",
            "rendered:debate",
            "does not invoke round commit",
        )
    post_decision = debate_shell.partition(decision_command)[2]
    if re.search(r'\$SC/regen_cards\b', post_decision):
        fail(
            errors,
            "normal-debate-transaction-owner",
            "rendered:debate",
            "directly invokes post-decision regen_cards instead of round commit",
        )

    for relative, text in (
        ("prompts/claude_delivery.tmpl", claude_delivery),
        ("agents/panel-review-claude-seat.md", claude_seat),
    ):
        if redefines_seat_blocks(text, include_inline_tokens=True):
            fail(
                errors,
                "seat-contract-owner",
                relative,
                "Claude-specific instructions restate a seat block owned by seat_contract.py",
            )

    for status_name in ("PANEL_VERDICT_READY", "PANEL_VERDICT_WRITE_FAILED", "PANEL_REVIEW_FAILED"):
        if status_name not in bootstrap:
            fail(errors, "referee-return-status", "bootstrap skill", f"missing {status_name}")
        if status_name in referee or status_name in protocol:
            fail(errors, "referee-return-status", "non-owner referee instructions", f"restate {status_name}")
        if status_name not in agent_status_hook:
            fail(errors, "referee-return-status", "Agent status hook", f"does not enforce {status_name}")
    for status_name in ("CLAUDE_SEAT_RAW_WRITTEN", "CLAUDE_SEAT_RAW_FAILED"):
        if status_name not in claude_delivery:
            fail(errors, "claude-return-status", "Claude delivery prompt", f"missing {status_name}")
        if status_name not in agent_status_hook:
            fail(errors, "claude-return-status", "Agent status hook", f"does not enforce {status_name}")

    pretool_groups = hook_config.get("hooks", {}).get("PreToolUse", [])
    if not any(group.get("matcher") == "SubagentHandback" for group in pretool_groups):
        fail(
            errors,
            "auto-handback-status-gate",
            "hooks/hooks.json",
            "missing SubagentHandback PreToolUse hook",
        )
    if 'event_name == "PreToolUse"' not in agent_status_hook:
        fail(
            errors,
            "auto-handback-status-gate",
            "Agent status hook",
            "does not validate PreToolUse hand-backs",
        )
    if 'payload.get("permission_mode") == "auto"' not in agent_status_hook:
        fail(
            errors,
            "auto-handback-status-gate",
            "Agent status hook",
            "does not distinguish auto-mode closing text",
        )
    for required in (
        "def deny_first_invalid_handback(payload):",
        "def set_handback_state(payload, state):",
        "def read_handback_state(payload):",
        "def terminal_failure_status(agent_type, message, transcript_path):",
        'handback_state != "accepted"',
        "is_exact_referee_failure_stub(message)",
        'UNKNOWN_RUN_ID = "unavailable"',
        '"updatedInput": {"message": terminal_message}',
    ):
        if required not in agent_status_hook:
            fail(
                errors,
                "auto-handback-retry-bound",
                "Agent status hook",
                f"missing bounded failure behavior `{required}`",
            )
    barrier_shell = "\n".join(fenced_blocks(barrier, "bash"))
    for required in (
        'timeout 100 bash -c',
        'until [ -f "<sentinel>"',
        'rc=$?; printf',
        'await_seats_rc=$(cat "<sentinel>")',
        'pkill -f "$(dirname "<sentinel>")/"',
    ):
        if required not in barrier_shell:
            fail(
                errors,
                "cli-barrier-command-shape",
                "agents/panel-review-cli-barrier.md",
                f"missing shell operation `{required}`",
            )
    for required in (
        "seat_timeout_seconds=<N>",
        "seat_timeout_seconds+60",
        "ceil(wait_budget_seconds/100)",
        "timeout: wait_budget_seconds*1000",
    ):
        if required not in barrier:
            fail(
                errors,
                "cli-barrier-timeout-owner",
                "agents/panel-review-cli-barrier.md",
                f"missing saved-timeout wait rule `{required}`",
            )
    if "`seat_timeout_seconds=$seat_timeout_seconds`" not in debate:
        fail(
            errors,
            "multi-batch-barrier-timeout",
            "skills/panel-review-for-agent/references/protocol.md",
            "manual multi-batch dispatch does not pass the saved timeout to the CLI barrier",
        )
    if not re.search(r"\brun_in_background:\s*true\b", barrier):
        fail(
            errors,
            "cli-barrier-command-shape",
            "agents/panel-review-cli-barrier.md",
            "await_seats wrapper is not issued as a background call",
        )
    if re.search(r"(?m)^\s*timeout\s+(?:540|570000)\s+bash\b", barrier_shell):
        fail(
            errors,
            "cli-barrier-command-shape",
            "agents/panel-review-cli-barrier.md",
            "contains an overlong foreground Bash wait",
        )

    # agy binds --model by DISPLAY LABEL ("Gemini 3.7 Flash (High)"), and a slug is not a stable
    # identifier across agy versions: on 1.1.10 the listed slug `gemini-3.1-pro-high` bound
    # Gemini 3.6 Flash (High) instead. An unrecognized value used the user's settings.json model
    # without error on 1.1.10, while 1.1.13 hard-errors. Shape-check both pins to reject slug forms;
    # the live binding check proves that a pin actually binds on the installed CLI.
    run_agy = read(root, "scripts/run_agy")
    display_label = re.compile(r"^Gemini [0-9]+(?:\.[0-9]+)* [A-Z][A-Za-z-]* \((?:High|Medium|Low)\)$")
    pins = {}
    for pin_name in ("PRIMARY_MODEL", "FALLBACK_MODEL"):
        match = re.search(rf'(?m)^{pin_name}="([^"]*)"$', run_agy)
        if match is None:
            fail(errors, "agy-model-pin-form", "scripts/run_agy", f"{pin_name} pin not found")
            continue
        pins[pin_name] = match.group(1)
        if not display_label.match(pins[pin_name]):
            fail(
                errors,
                "agy-model-pin-form",
                "scripts/run_agy",
                f"{pin_name} is not an agy display label (slug?): {pins[pin_name]!r}",
            )
    # A fallback identical to the primary is not a fallback: the retry would re-run the model that
    # just failed. The label shape above already keeps both pins on Gemini, never agy's
    # Claude/GPT-OSS entries.
    if len(pins) == 2 and pins["PRIMARY_MODEL"] == pins["FALLBACK_MODEL"]:
        fail(errors, "agy-model-pin-form", "scripts/run_agy", "fallback pin equals the primary pin")


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args(argv)
    errors = []
    try:
        check_rendered_contracts(errors)
        check_tree(errors, args.root.resolve())
    except RuntimeError as error:
        print(f"contract-check-setup: {error}", file=sys.stderr)
        return 2
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1
    print("instruction contracts: OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
