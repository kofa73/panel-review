#!/usr/bin/env bash
# run_codex — the ONLY approved way to call the Codex peer-review seat.
# Mirror of run_agy for the OpenAI/GPT participant.
#
# Usage:
#   run_codex "<prompt>"     # prompt as $1
#   run_codex < promptfile   # prompt on stdin (no args)
# Output: final assistant message on stdout. Nonzero exit = seat failed
#         (caller degrades). codex missing -> exit 127.
#
# Pins the non-negotiables structurally so they can't be fat-fingered:
#  - --profile panel-review  (NEVER hardcode -m / a raw model; the profile carries
#                             model selection. Panel Review's profile is separate
#                             from upstream peer-review and is auto-created from
#                             assets/default-panel-review.config.toml on first use.
#                             Override only the profile name via CODEX_PROFILE.
#                             The profile does NOT have the last word: Codex layers
#                             cwd/tree/repo config ABOVE it, so a reviewed repository
#                             shipping its own .codex/config.toml picks the seat's
#                             model. That is the user's file and the panel does not
#                             fight it — `preflight` reports the condition, `start`
#                             asks, and the binding below is recorded. See
#                             issues/archive/47-codex-model-pin-is-not-authoritative.md.)
#  - --dangerously-bypass-approvals-and-sandbox
#                            (Codex runs with NO sandbox and NO approval prompts.
#                             This is required, not a convenience: under ANY Codex
#                             sandbox — read-only OR workspace-write — Codex
#                             auto-cancels every MCP tool call ("call cancelled"),
#                             so its tilth code-intelligence never runs; and the
#                             review now expects the seat to write throwaway scratch
#                             scripts to verify deterministic things. approval_policy
#                             alone does not lift the MCP cancellation. Repo
#                             integrity is NOT delegated to this sandbox: it is
#                             enforced by scripts/repo_guard (snapshot + auto-revert
#                             of any tracked-file change) plus the disposable,
#                             externally-sandboxed container the panel runs in — the
#                             same trust model run_agy already relies on.)
#  - -c mcp_servers.tilth.args=["--mcp"]
#                            (defense-in-depth: force Codex's tilth server into
#                             read-only MCP mode, stripping any global `--edit` the
#                             user configured via `tilth install codex`. panel-review
#                             never edits the code under review.)
# Set CODEX_SEAT_MODEL_FILE=/path to record what the seat ACTUALLY bound (see the
# write below). await_seats sets it to /tmp/<ID>/codex-model.txt for every dispatch.
set -euo pipefail

PROFILE="${CODEX_PROFILE:-panel-review}"
MODEL_FILE="${CODEX_SEAT_MODEL_FILE:-}"

command -v codex >/dev/null 2>&1 || { echo "run_codex: codex CLI not found" >&2; exit 127; }

# Ensure our own Codex profile exists (decoupled from upstream peer-review).
# Copy the shipped default on first use; never clobber an existing/tuned file.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE_FILE="$HOME/.codex/${PROFILE}.config.toml"
if [ ! -f "$PROFILE_FILE" ]; then
  template="$SCRIPT_DIR/../assets/default-${PROFILE}.config.toml"
  if [ -f "$template" ]; then
    mkdir -p "$HOME/.codex"
    cp "$template" "$PROFILE_FILE"
  fi
fi

promptfile="$(mktemp /tmp/codex_prompt.XXXXXX)"
outfile="$(mktemp /tmp/codex_out.XXXXXX)"
errfile="$(mktemp /tmp/codex_err.XXXXXX)"
trap 'rm -f "$promptfile" "$outfile" "$errfile"' EXIT

if [ "$#" -ge 1 ]; then
  printf '%s' "$1" > "$promptfile"
else
  cat > "$promptfile"
fi

# -o writes the final assistant message to outfile in BOTH output modes, so no
# --json is needed to get it (verified on codex-cli 0.153.4; the human processor is
# constructed with the same last_message_file, codex-rs/exec/src/lib.rs:787-793).
# Human mode is what we want here for a second reason: it prints the resolved config
# summary — including the model that actually bound — to STDERR, which --json
# replaces with a thread.started event carrying only a thread id. Codex's own stdout
# is the human transcript and is discarded; the seat's response comes from outfile.
# See the header for why the sandbox is bypassed (MCP/tilth + scratch writes) and
# how repo integrity is enforced instead (scripts/repo_guard + the container).
if ! codex exec --profile "$PROFILE" --dangerously-bypass-approvals-and-sandbox \
       -c 'mcp_servers.tilth.args=["--mcp"]' \
       -o "$outfile" < "$promptfile" > /dev/null 2>"$errfile"; then
  echo "run_codex: codex exec failed (profile=$PROFILE)" >&2
  exit 1
fi

# Record the binding Codex reported for itself, so the verdict can state what really
# reviewed the code rather than what the profile asked for. The two values live in the
# config summary Codex writes to stderr between its first two `--------` rules; the
# prompt echo and the transcript follow the second rule, so bound the range instead of
# grepping the whole stream (a prompt could contain a line starting "model:"). Nothing
# downstream depends on this file, so an unrecognized header costs the record, not the
# pass. ANSI styling is stripped first: Codex omits it for a non-terminal stderr today,
# but that is its choice to change, not a contract.
if [ -n "$MODEL_FILE" ]; then
  header="$(sed -e $'s/\033\\[[0-9;]*m//g' "$errfile" | sed -n '/^-\{3,\}$/,/^-\{3,\}$/p')"
  model="$(printf '%s\n' "$header" | sed -n 's/^model:[[:space:]]*//p' | head -n1)"
  effort="$(printf '%s\n' "$header" | sed -n 's/^reasoning effort:[[:space:]]*//p' | head -n1)"
  if [ -n "$model" ]; then
    mkdir -p "$(dirname "$MODEL_FILE")"
    printf 'model=%s\neffort=%s\n' "$model" "${effort:-unknown}" > "$MODEL_FILE.tmp.$$"
    mv -f "$MODEL_FILE.tmp.$$" "$MODEL_FILE"
  fi
fi

cat "$outfile"
