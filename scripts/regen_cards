#!/usr/bin/env bash
# regen_cards — rebuild every card from the canonical index (used on resume).
# State is never inferred from cards; cards are always re-derived from the index.
# Stale issue cards are deleted before current cards are projected from the index.
#
# Usage: regen_cards --id ID --workdir DIR
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"; . "$here/_panel_common.sh"

id="" workdir=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --id) id="$2"; shift 2;;
    --workdir) workdir="$2"; shift 2;;
    *) echo "regen_cards: unknown arg: $1" >&2; exit 2;;
  esac
done
panel_require_id "$id"; [ -n "$workdir" ] || { echo "regen_cards: need --workdir" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "regen_cards: jq not found" >&2; exit 127; }

f="/tmp/$id/index.json"; [ -f "$f" ] || { echo "regen_cards: no index for $id" >&2; exit 1; }
dir="$workdir/.panel-review/$id"; mkdir -p "$dir"
if ! jq -e 'type == "object" and (.issues | type == "array") and all(.issues[]; type == "object" and (.id | type == "string" and length > 0))' "$f" >/dev/null 2>&1; then
  echo "regen_cards: index issue list is invalid" >&2
  exit 1
fi

# Identify current issue ids first so stale cards can be removed before rendering.
live=" "
while IFS= read -r iid; do
  [ -n "$iid" ] || continue
  panel_valid_id "$iid" || { echo "regen_cards: invalid issue id: '$iid'" >&2; exit 1; }
  live="$live$iid "
done < <(jq -r '.issues[].id' "$f")
for card in "$dir"/issue-*.md; do
  [ -e "$card" ] || continue
  base="$(basename "$card" .md)"; iid="${base#issue-}"
  case "$live" in *" $iid "*) : ;; *) rm -f -- "$card" ;; esac
done

# Render each current issue's card.
failed=0
while IFS= read -r rec; do
  [ -n "$rec" ] || continue
  iid="$(printf '%s' "$rec" | jq -r '.id')"
  printf '%s' "$rec" | "$here/project_card" --id "$id" --workdir "$workdir" >/dev/null \
    || { echo "regen_cards: skipped $iid" >&2; failed=1; continue; }
done < <(jq -c '.issues[]' "$f")

[ "$failed" -eq 0 ] || exit 1
